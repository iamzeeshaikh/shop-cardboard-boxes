# Tracking is intentionally disabled unless the request hostname is the production domain.
# Set this only during an approved production deployment.
PUBLIC_ENABLE_PRODUCTION_TRACKING=false

# Future production form/email delivery adapter. Local forms remain mocked without these.
# The endpoint must accept multipart/form-data and perform the approved SMTP/provider delivery.
FORM_DELIVERY_ENDPOINT=
FORM_DELIVERY_SECRET=
# Optional provider-side SMTP reference fields; the Astro browser/server output never exposes them.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
FORM_FROM_EMAIL=
FORM_TO_EMAIL=

# The recovered checkout uses Cash on Delivery; PayPal was disabled.
# This adapter receives validated COD orders for persistence/fulfilment after approval.
# No card gateway credential is required because recovered PayPal state is disabled.
ORDER_DELIVERY_ENDPOINT=
ORDER_DELIVERY_SECRET=
