---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSnapshot } from '../lib/snapshots';
import type { Snapshot } from '../lib/snapshots';
import products from '../data/products.json';
import { enhance } from '../lib/seo/enhance';
import { newCategoryByPath } from '../data/seo/categories';
import { renderNewCategory } from '../lib/seo/render-category';
import { toSnapshot } from '../lib/seo/chrome';

const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;

// Categories authored in this pass are not in the WordPress route index.
const authoredCategory = newCategoryByPath.get(pathname);
const found = authoredCategory ? renderNewCategory(authoredCategory) : getSnapshot(pathname);

const snapshot: Snapshot = found ? enhance(found) : toSnapshot({
  path: pathname,
  title: 'Page not found - Shop Cardboard Boxes',
  description: '',
  robots: 'noindex, follow',
  bodyClass: 'error404',
  contentHtml: '<div class="site-content"><div class="scb-not-found"><h1>Page not found</h1><p>The page you requested could not be found. Try the <a href="/products/">full box catalogue</a>, our <a href="/resources/">packaging guides</a>, or <a href="/contact-us/">talk to us</a>.</p><a class="scb-btn scb-btn-solid" href="/">Return to homepage</a></div></div>',
});

const productPrice = products.find((product) => product.path === snapshot.path)?.price;
const contentHtml = productPrice
  ? snapshot.contentHtml.replace(
      /Starting From the \$0\.20 per piece\./g,
      `Starting From the $${Number(productPrice).toFixed(2)} per piece.`,
    )
  : snapshot.contentHtml;
---

<BaseLayout snapshot={snapshot} status={found ? 200 : 404}>
  <Fragment set:html={contentHtml} />
</BaseLayout>
