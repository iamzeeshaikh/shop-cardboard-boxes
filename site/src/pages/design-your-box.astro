---
import BaseLayout from '../layouts/BaseLayout.astro';
import { toSnapshot } from '../lib/seo/chrome';
import { breadcrumbHtml, breadcrumbJsonLd, faqHtml, faqJsonLd, esc, abs } from '../lib/seo/util';
import { cta, linkRow, specTable } from '../lib/seo/blocks';
import { boxStyles } from '../lib/seo/diagrams';

const path = '/design-your-box/';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Design your box', path }];

/** Only structures, materials and finishes we actually produce appear here. */
const STYLES = [
  { value: 'rsc', name: 'Shipping carton', note: 'Regular slotted carton. Flaps meet and are taped. The cheapest and strongest per unit.' },
  { value: 'mailer', name: 'Mailer', note: 'Hinged lid that tucks closed. No tape, fast to pack, printable inner face.' },
  { value: 'tuck', name: 'Tuck-end carton', note: 'Folding retail carton in thin board. Cosmetics, food, supplements.' },
  { value: 'lid-base', name: 'Lid and base', note: 'Separate lift-off lid over a tray. Reopens indefinitely.' },
  { value: 'rigid', name: 'Rigid box', note: 'Wrapped chipboard frame. Ships assembled. Premium feel.' },
  { value: 'round', name: 'Round box', note: 'Cylindrical body with a lift-off lid. Quoted as diameter × height.' },
];

const MATERIALS = [
  { value: 'corrugated-kraft', name: 'Kraft corrugated', note: 'Brown, strong, high recycled content. The shipping default.' },
  { value: 'corrugated-white', name: 'White corrugated', note: 'White outer liner for better print, same structure.' },
  { value: 'sbs', name: 'SBS folding board', note: 'Bleached white through the board. Best print surface, food-safe grades.' },
  { value: 'recycled', name: 'Recycled board', note: 'High recycled content, slightly greyer base, good print with a coated top.' },
  { value: 'rigid-chipboard', name: 'Rigid chipboard', note: 'Structural frame for rigid boxes, wrapped in printed paper.' },
  { value: 'food-grade', name: 'Food-grade board', note: 'Food-contact board with food-safe inks. Coating chosen separately.' },
];

const BOARDS = [
  { value: 'single-32', name: 'Single wall · 32 ECT', note: 'Up to about 20 lb. Parcel network, retail, general ecommerce.' },
  { value: 'double-48', name: 'Double wall · 48 ECT', note: '30–65 lb, or anything palletised and stacked.' },
  { value: 'triple-90', name: 'Triple wall · 90+ ECT', note: '65 lb and above. Machinery, industrial, export.' },
  { value: 'folding', name: 'Folding carton board', note: 'Thin board for retail cartons rather than corrugated.' },
  { value: 'advise', name: 'Recommend one for me', note: 'Tell us the weight in the notes and we will specify it.' },
];

const QUANTITIES = [
  { value: '100', name: '100', note: 'Our minimum. Digital printing, no plate cost.' },
  { value: '500', name: '500', note: 'Offset and flexo become viable.' },
  { value: '2500', name: '2,500', note: 'Setup cost largely disappears into the run.' },
  { value: '10000', name: '10,000', note: 'Mill-rate board, call-off delivery available.' },
  { value: 'custom', name: 'Another quantity', note: 'Enter your own figure below.' },
];

const PRINTING = [
  { value: 'none', name: 'Unprinted', note: 'Plain kraft or white. Cheapest, and right for most transit outers.' },
  { value: 'digital', name: 'Digital, full colour', note: 'No plate cost. Best below about 500 units.' },
  { value: 'offset', name: 'Offset litho', note: 'Photographic quality and exact Pantone matching. From 500 units.' },
  { value: 'flexo', name: 'Flexo, 1–2 colours', note: 'Direct onto corrugated. Bold flat artwork, from 500 units.' },
  { value: 'inside-out', name: 'Printed inside and out', note: 'Printed interior — the part customers actually photograph.' },
];

const FINISHES = [
  { value: 'none', name: 'No finish', note: 'Uncoated. Fully recyclable, natural feel.' },
  { value: 'matte', name: 'Matte lamination', note: 'Smooth and non-reflective. Complicates recycling.' },
  { value: 'gloss', name: 'Gloss lamination', note: 'Reflective and wipeable.' },
  { value: 'soft-touch', name: 'Soft touch', note: 'Velvety film. Premium cosmetics and fragrance.' },
  { value: 'spot-uv', name: 'Spot UV', note: 'Raised gloss over matte. Best on a logo only.' },
  { value: 'foil', name: 'Foil stamping', note: 'Pressed metallic foil. Carries a die cost, from 500 units.' },
];

const ARTWORK = [
  { value: 'ready', name: 'Print-ready artwork', note: 'Vector, fonts outlined, ready for the dieline.' },
  { value: 'draft', name: 'Artwork in progress', note: 'We will supply the dieline for your designer to work to.' },
  { value: 'need-design', name: 'We need design help', note: 'Free design support is included with every order.' },
  { value: 'none', name: 'No printing needed', note: 'Plain unprinted boxes.' },
];

const options = (name: string, items: { value: string; name: string; note: string }[]) => `<ul class="scb-cfg-options">${items.map((item, index) => `<li class="scb-cfg-option"><input type="radio" id="${esc(name)}-${index}" name="${esc(name)}" value="${esc(item.value)}" data-label="${esc(item.name)}" /><label for="${esc(name)}-${index}"><span class="scb-cfg-opt-name">${esc(item.name)}</span><span class="scb-cfg-opt-note">${esc(item.note)}</span></label></li>`).join('')}</ul>`;

const nav = (back: boolean, next: boolean) => `<div class="scb-cfg-nav">${back ? '<button type="button" class="scb-cfg-back">Back</button>' : ''}${next ? '<button type="button" class="scb-cfg-next">Continue</button>' : ''}</div>`;

const STEP_NAMES = ['Style', 'Size', 'Material', 'Board', 'Quantity', 'Printing', 'Finish', 'Artwork', 'Notes', 'Contact', 'Review'];

const FAQS = [
  { q: 'Is this a real quote or an estimate?', a: 'Neither — it is a specification. The configurator collects what a packaging specialist needs in order to price the job accurately, and a person replies with real pricing, usually within one working day. We deliberately do not show an instant number, because board grade, print method and quantity interact in ways a calculator gets wrong.' },
  { q: 'Do I have to complete every step?', a: 'No. Only the box style, the dimensions and your contact details are needed. Anything you skip becomes a question we ask, or a recommendation we make from what you have told us.' },
  { q: 'What is the preview showing me?', a: 'A proportional sketch of the size you have entered, so you can sanity-check that the numbers describe the box you had in mind. It is not a dieline and not production artwork. The print-ready dieline is produced by our design team after you request a quote, and it is free.' },
  { q: 'Can I upload my artwork here?', a: 'Yes. The artwork step accepts a file up to 15 MB — PDF, AI, EPS, PNG or JPG. If your file is larger, submit the configuration first and we will send you an upload link.' },
  { q: 'What if I do not know which board strength I need?', a: 'Choose "recommend one for me" and put the product weight in the notes. Board grade follows almost entirely from gross weight and whether the boxes are stacked, so those two facts are usually enough for us to specify it.' },
  { q: 'Which units should I use for dimensions?', a: 'Either — there is a unit selector. Dimensions are internal, measured length × width × height with the opening facing up. Round boxes are quoted as diameter × height instead.' },
  { q: 'Is there a minimum order?', a: '100 boxes. That is a genuine floor rather than a headline figure. The per-unit price is higher at 100 than at 2,500 because setup is spread over fewer pieces, but nothing about the process changes.' },
  { q: 'How long does production take?', a: '8–10 business days from artwork approval, with delivery included anywhere in the United States. Rigid boxes and specialist finishes such as foil add a few days. If you have a fixed date, say so in the notes and we will confirm it before you commit.' },
  { q: 'Can I configure several different boxes?', a: 'Submit one configuration, then mention the others in the notes. For a range, it is usually faster to talk to a specialist directly than to fill the form several times.' },
  { q: 'Does using the configurator commit me to anything?', a: 'No. It produces a specification and a conversation. There is no obligation, no payment step and no account to create.' },
];

const contentHtml = `<div class="site-content">
  <div class="scb-intro">
    <div class="scb-intro-inner">
      <div>
        ${breadcrumbHtml(crumbs)}
        <span class="scb-eyebrow">Custom packaging</span>
        <h1>Design Your Box</h1>
        <p>Work through the specification the way a packaging specialist would: structure first, then size, then board, then how it is printed. It takes a couple of minutes and produces a brief precise enough to quote from.</p>
        <p>Every option below is something we actually produce. There is no instant price at the end, because board grade, print method and quantity interact in ways a calculator gets wrong — a person prices it instead, usually the same working day.</p>
        <ul class="scb-intro-facts">
          <li><strong>11 steps</strong>about two minutes</li>
          <li><strong>100 boxes</strong>minimum order</li>
          <li><strong>Free</strong>dieline and design support</li>
        </ul>
      </div>
      <div></div>
    </div>
  </div>

  <div class="scb-cfg">
    <div class="scb-cfg-grid">
      <div>
        <div class="scb-cfg-progress">
          <div class="scb-cfg-bar"><span></span></div>
          <ol class="scb-cfg-steps">${STEP_NAMES.map((name) => `<li data-state="todo">${esc(name)}</li>`).join('')}</ol>
        </div>

        <form name="Design Your Box" aria-label="Design your box configurator" method="post" enctype="multipart/form-data">

          <section class="scb-cfg-step" data-active="true">
            <span class="scb-cfg-stepno">Step 1 of 11</span>
            <h2>Box style</h2>
            <p>The structure decides most of the cost and nearly all of how the box feels. If none of these is quite right, pick the closest and say so in the notes.</p>
            <div data-require-group="box_style">${options('box_style', STYLES)}<span class="scb-cfg-error" role="alert"></span></div>
            ${nav(false, true)}
          </section>

          <section class="scb-cfg-step">
            <span class="scb-cfg-stepno">Step 2 of 11</span>
            <h2>Dimensions</h2>
            <p>Internal dimensions — the space your product actually has. Measure the opening with the flaps folded out of the way. For a round box, enter the diameter as length and leave width blank.</p>
            <div class="scb-cfg-fields">
              <div class="scb-cfg-field"><label for="cfg-l">Length</label><input id="cfg-l" name="length_value" type="text" inputmode="decimal" data-required data-kind="number" data-required-message="Enter the internal length." /><span class="scb-cfg-error" role="alert"></span></div>
              <div class="scb-cfg-field"><label for="cfg-w">Width</label><input id="cfg-w" name="width_value" type="text" inputmode="decimal" /><span class="scb-cfg-hint">Leave blank for a round box.</span></div>
              <div class="scb-cfg-field"><label for="cfg-h">Height</label><input id="cfg-h" name="height_value" type="text" inputmode="decimal" data-required data-kind="number" data-required-message="Enter the internal height." /><span class="scb-cfg-error" role="alert"></span></div>
              <div class="scb-cfg-field"><label for="cfg-unit">Units</label><select id="cfg-unit" name="dimension_unit"><option value="in">Inches</option><option value="mm">Millimetres</option><option value="cm">Centimetres</option></select></div>
            </div>
            ${nav(true, true)}
          </section>

          <section class="scb-cfg-step">
            <span class="scb-cfg-stepno">Step 3 of 11</span>
            <h2>Material</h2>
            <p>Corrugated for anything that ships. Folding board for retail cartons. Food-grade where the box touches food — the coating is chosen separately.</p>
            <div data-require-group="material">${options('material', MATERIALS)}<span class="scb-cfg-error" role="alert"></span></div>
            ${nav(true, true)}
          </section>

          <section class="scb-cfg-step">
            <span class="scb-cfg-stepno">Step 4 of 11</span>
            <h2>Board strength</h2>
            <p>Board grade follows from gross weight and whether the boxes stack. If you are unsure, choose the last option and tell us the weight at the notes step.</p>
            <div data-require-group="board_strength">${options('board_strength', BOARDS)}<span class="scb-cfg-error" role="alert"></span></div>
            ${nav(true, true)}
          </section>

          <section class="scb-cfg-step">
            <span class="scb-cfg-stepno">Step 5 of 11</span>
            <h2>Quantity</h2>
            <p>Unit price falls in steps rather than smoothly, because setup costs spread across the run. These are the steps worth planning around.</p>
            <div data-require-group="quantity">${options('quantity', QUANTITIES)}<span class="scb-cfg-error" role="alert"></span></div>
            <div class="scb-cfg-fields" style="margin-top:14px">
              <div class="scb-cfg-field scb-cfg-full"><label for="cfg-qty">Your quantity, if different</label><input id="cfg-qty" name="quantity_custom" type="text" inputmode="numeric" placeholder="e.g. 3,500" /></div>
            </div>
            ${nav(true, true)}
          </section>

          <section class="scb-cfg-step">
            <span class="scb-cfg-stepno">Step 6 of 11</span>
            <h2>Printing</h2>
            <p>Below about 500 units digital is nearly always cheapest. Above it, offset or flexo take over. A printed interior is the option most people underrate.</p>
            <div data-require-group="printing">${options('printing', PRINTING)}<span class="scb-cfg-error" role="alert"></span></div>
            ${nav(true, true)}
          </section>

          <section class="scb-cfg-step">
            <span class="scb-cfg-stepno">Step 7 of 11</span>
            <h2>Finish and colour</h2>
            <p>Pick one hero finish and let the rest of the box stay quiet. Laminations complicate recycling, so we will flag the trade-off if it matters to you.</p>
            <div data-require-group="finish">${options('finish', FINISHES)}<span class="scb-cfg-error" role="alert"></span></div>
            <div class="scb-cfg-fields" style="margin-top:14px">
              <div class="scb-cfg-field scb-cfg-full"><label for="cfg-colour">Brand colours</label><input id="cfg-colour" name="colour_note" type="text" placeholder="e.g. Pantone 2955 C and warm grey" /><span class="scb-cfg-hint">Naming a Pantone helps us tell you whether offset is worth it.</span></div>
            </div>
            ${nav(true, true)}
          </section>

          <section class="scb-cfg-step">
            <span class="scb-cfg-stepno">Step 8 of 11</span>
            <h2>Artwork</h2>
            <p>Dieline preparation, artwork setup and a print-ready proof are included with every order. Tell us where you are and we will pick it up from there.</p>
            <div data-require-group="artwork_status">${options('artwork_status', ARTWORK)}<span class="scb-cfg-error" role="alert"></span></div>
            <div class="scb-cfg-fields" style="margin-top:14px">
              <div class="scb-cfg-field scb-cfg-full"><label for="cfg-file">Upload artwork (optional)</label><input id="cfg-file" name="artwork_file" type="file" accept=".pdf,.ai,.eps,.png,.jpg,.jpeg,.svg" /><span class="scb-cfg-hint">Up to 15 MB — PDF, AI, EPS, PNG, JPG or SVG. Larger files can be sent by link after you submit.</span></div>
            </div>
            ${nav(true, true)}
          </section>

          <section class="scb-cfg-step">
            <span class="scb-cfg-stepno">Step 9 of 11</span>
            <h2>Anything else we should know</h2>
            <p>Product weight, a launch date, an existing box you want matched, a retailer specification — anything here saves a round of questions.</p>
            <div class="scb-cfg-fields">
              <div class="scb-cfg-field scb-cfg-full"><label for="cfg-notes">Additional requirements</label><textarea id="cfg-notes" name="additional_requirements" rows="4" placeholder="e.g. product weighs 12 lb, boxes stack six high in a warehouse, needed by 15 October"></textarea></div>
            </div>
            ${nav(true, true)}
          </section>

          <section class="scb-cfg-step">
            <span class="scb-cfg-stepno">Step 10 of 11</span>
            <h2>Where should we send the quote?</h2>
            <p>A packaging specialist replies with pricing, board options and a lead time — usually within one working day.</p>
            <div class="scb-cfg-fields">
              <div class="scb-cfg-field"><label for="cfg-name">Name</label><input id="cfg-name" name="name" type="text" autocomplete="name" data-required data-required-message="We need a name to reply to." /><span class="scb-cfg-error" role="alert"></span></div>
              <div class="scb-cfg-field"><label for="cfg-email">Email</label><input id="cfg-email" name="email" type="email" autocomplete="email" data-required data-required-message="We need an email address to send the quote." /><span class="scb-cfg-error" role="alert"></span></div>
              <div class="scb-cfg-field"><label for="cfg-phone">Phone (optional)</label><input id="cfg-phone" name="phone" type="tel" autocomplete="tel" /></div>
              <div class="scb-cfg-field"><label for="cfg-company">Company (optional)</label><input id="cfg-company" name="company" type="text" autocomplete="organization" /></div>
            </div>
            ${nav(true, true)}
          </section>

          <section class="scb-cfg-step">
            <span class="scb-cfg-stepno">Step 11 of 11</span>
            <h2>Review and send</h2>
            <p>This is what we will receive. Use Back to change anything before you send it.</p>
            <ul class="scb-cfg-review"></ul>
            <p class="scb-cfg-hp"><label for="cfg-hp">Leave this field empty</label><input id="cfg-hp" name="website" type="text" tabindex="-1" autocomplete="off" /></p>
            <textarea name="configuration_summary" hidden aria-hidden="true" tabindex="-1" aria-label="Configuration summary"></textarea>
            <div class="scb-cfg-nav">
              <button type="button" class="scb-cfg-back">Back</button>
              <button type="submit" class="scb-cfg-submit">Send my specification</button>
            </div>
          </section>

          <div class="scb-cfg-nav scb-cfg-nav-static"><button type="submit" class="scb-cfg-submit">Send my specification</button></div>
        </form>
      </div>

      <aside class="scb-cfg-aside">
        <h2>Your box so far</h2>
        <div class="scb-cfg-preview"></div>
        <ul class="scb-cfg-summary"><li><span class="k">Nothing selected yet</span></li></ul>
      </aside>
    </div>
  </div>

  <section class="scb-section scb-tinted">
    <h2>What each choice actually changes</h2>
    <p class="scb-lede">If you would rather understand the options before working through them, this is the short version. Each row links to the guide that covers it properly.</p>
    ${specTable('The specification decisions, and what drives each one', ['Decision', 'Driven by', 'Where it is explained'], [
      ['<strong>Structure</strong>', 'How the box is opened, and whether it ships flat', '<a href="/resources/box-styles-explained/">Box styles explained</a>'],
      ['<strong>Dimensions</strong>', 'The packed product, and your carrier\'s rate bands', '<a href="/resources/how-to-measure-a-cardboard-box/">How to measure a box</a>'],
      ['<strong>Material</strong>', 'Whether it ships, sits on a shelf, or touches food', '<a href="/resources/cardboard-packaging-materials/">Materials compared</a>'],
      ['<strong>Board strength</strong>', 'Gross weight and stack height', '<a href="/resources/corrugated-box-strength-guide/">ECT and Mullen explained</a>'],
      ['<strong>Quantity</strong>', 'Where setup cost stops dominating the unit price', '<a href="/product-category/wholesale-cardboard-boxes/">Volume price breaks</a>'],
      ['<strong>Printing</strong>', 'Run length first, artwork type second', '<a href="/resources/custom-box-printing-methods/">Printing methods</a>'],
      ['<strong>Finish</strong>', 'How the box should feel, and recyclability', '<a href="/resources/recyclable-cardboard-packaging/">Recyclable packaging</a>'],
    ])}
  </section>

  <section class="scb-section">
    <h2>The structures you can configure</h2>
    <p>Six base structures cover most of what we make. They differ in how they close, whether they ship flat, and what they cost per unit.</p>
    ${boxStyles()}
    <p>If your product needs a structure that is not here — a gable top, a hexagon, a sleeve over a tray — say so in the notes step and we will build it. The configurator covers the common cases rather than every dieline we hold.</p>
  </section>

  <section class="scb-section scb-tinted">
    <h2>What happens after you send it</h2>
    <ol>
      <li><strong>A specialist reads the specification.</strong> Not a script — a person who quotes these boxes daily and will tell you if something in the combination does not work.</li>
      <li><strong>You get pricing, usually within one working day.</strong> With board options where there is a sensible cheaper alternative.</li>
      <li><strong>We produce the dieline free of charge,</strong> and your designer works to it — or ours does, also free.</li>
      <li><strong>You approve a proof.</strong> Digital for content and placement; printed if colour accuracy matters to the launch.</li>
      <li><strong>Production runs 8–10 business days</strong> from artwork approval, with delivery included anywhere in the United States.</li>
    </ol>
    ${linkRow([
      { path: '/products/', label: 'Browse all 186 box styles' },
      { path: '/resources/', label: 'Read the packaging guides' },
      { path: '/product-category/wholesale-cardboard-boxes/', label: 'Volume pricing' },
      { path: '/contact-us/', label: 'Talk to someone instead' },
    ])}
  </section>

  ${faqHtml(FAQS, 'Questions about the configurator')}
  ${cta('Would rather just talk it through?', 'Send us the product and roughly what you need. A specialist will work through the specification with you and quote it.', [{ path: '/contact-us/', label: 'Contact a specialist' }, { path: '/resources/', label: 'Read the guides first', kind: 'ghost' }])}
</div>`;

const snapshot = toSnapshot({
  path,
  title: 'Design Your Box | Custom Cardboard Box Configurator',
  description: 'Configure a custom cardboard box step by step — structure, size, board, printing and finish — and send the specification for a real quote from a packaging specialist.',
  contentHtml,
  bodyClass: 'scb-configurator-page',
  metaTags: '<link rel="stylesheet" href="/scb-configurator.css" />',
  jsonLd: [
    breadcrumbJsonLd(crumbs),
    faqJsonLd(FAQS, path),
    JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      '@id': `${abs(path)}#webpage`,
      url: abs(path),
      name: 'Design Your Box',
      description: 'A step-by-step configurator for specifying a custom cardboard box.',
      isPartOf: { '@type': 'WebSite', name: 'Shop Cardboard Boxes', url: abs('/') },
    }),
  ],
});
---

<BaseLayout snapshot={snapshot}>
  <Fragment set:html={snapshot.contentHtml} />
  <script is:inline src="/scb-configurator.js" defer></script>
</BaseLayout>
