---
import BaseLayout from '../layouts/BaseLayout.astro';
import { toSnapshot } from '../lib/seo/chrome';
import { breadcrumbHtml, breadcrumbJsonLd, faqHtml, faqJsonLd, abs } from '../lib/seo/util';
import { cta, linkRow, specTable } from '../lib/seo/blocks';
import { boxStyles } from '../lib/seo/diagrams';
import { configurator } from '../lib/seo/configurator';

const path = '/design-your-box/';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Design your box', path }];

const FAQS = [
  { q: 'Is this a real quote or an estimate?', a: 'Neither — it is a specification. The configurator collects what a packaging specialist needs in order to price the job accurately, and a person replies with real pricing, usually within one working day. We deliberately do not show an instant number, because board grade, print method and quantity interact in ways a calculator gets wrong.' },
  { q: 'Do I have to complete every step?', a: 'No. Only the box style, the dimensions and your contact details are needed. Anything you skip becomes a question we ask, or a recommendation we make from what you have told us.' },
  { q: 'What is the preview showing me?', a: 'A proportional sketch of the size you have entered, so you can sanity-check that the numbers describe the box you had in mind. It is not a dieline and not production artwork. The print-ready dieline is produced by our design team after you request a quote, and it is free.' },
  { q: 'Can I upload my artwork here?', a: 'Yes. The artwork step accepts a file up to 15 MB — PDF, AI, EPS, PNG or JPG. If your file is larger, submit the configuration first and we will send you an upload link.' },
  { q: 'What if I do not know which board strength I need?', a: 'Choose "recommend one for me" and put the product weight in the notes. Board grade follows almost entirely from gross weight and whether the boxes are stacked, so those two facts are usually enough for us to specify it.' },
  { q: 'Which units should I use for dimensions?', a: 'Either — there is a unit selector. Dimensions are internal, measured length × width × height with the opening facing up. Round boxes are quoted as diameter × height instead.' },
  { q: 'Is there a minimum order?', a: '100 boxes. That is a genuine floor rather than a headline figure. The per-unit price is higher at 100 than at 2,500 because setup is spread over fewer pieces, but nothing about the process changes.' },
  { q: 'How long does production take?', a: '8–10 business days from artwork approval, with delivery included anywhere in the United States. Rigid boxes and specialist finishes such as foil add a few days. If you have a fixed date, say so in the notes and we will confirm it before you commit.' },
  { q: 'Can I configure several different boxes?', a: 'Submit one configuration, then mention the others in the notes. For a range, it is usually faster to talk to a specialist directly than to fill the form several times.' },
  { q: 'Does using the configurator commit me to anything?', a: 'No. It produces a specification and a conversation. There is no obligation, no payment step and no account to create.' },
];

const contentHtml = `<div class="site-content">
  <div class="scb-intro">
    <div class="scb-intro-inner">
      <div>
        ${breadcrumbHtml(crumbs)}
        <span class="scb-eyebrow">Custom packaging</span>
        <h1>Design Your Box</h1>
        <p>Work through the specification the way a packaging specialist would: structure first, then size, then board, then how it is printed. It takes a couple of minutes and produces a brief precise enough to quote from.</p>
        <p>Every option below is something we actually produce. There is no instant price at the end, because board grade, print method and quantity interact in ways a calculator gets wrong — a person prices it instead, usually the same working day.</p>
        <ul class="scb-intro-facts">
          <li><strong>11 steps</strong>about two minutes</li>
          <li><strong>100 boxes</strong>minimum order</li>
          <li><strong>Free</strong>dieline and design support</li>
        </ul>
      </div>
      <div></div>
    </div>
  </div>

  ${configurator({ prefix: 'tool' })}

  <section class="scb-section scb-tinted">
    <h2>What each choice actually changes</h2>
    <p class="scb-lede">If you would rather understand the options before working through them, this is the short version. Each row links to the guide that covers it properly.</p>
    ${specTable('The specification decisions, and what drives each one', ['Decision', 'Driven by', 'Where it is explained'], [
      ['<strong>Structure</strong>', 'How the box is opened, and whether it ships flat', '<a href="/resources/box-styles-explained/">Box styles explained</a>'],
      ['<strong>Dimensions</strong>', 'The packed product, and your carrier\'s rate bands', '<a href="/resources/how-to-measure-a-cardboard-box/">How to measure a box</a>'],
      ['<strong>Material</strong>', 'Whether it ships, sits on a shelf, or touches food', '<a href="/resources/cardboard-packaging-materials/">Materials compared</a>'],
      ['<strong>Board strength</strong>', 'Gross weight and stack height', '<a href="/resources/corrugated-box-strength-guide/">ECT and Mullen explained</a>'],
      ['<strong>Quantity</strong>', 'Where setup cost stops dominating the unit price', '<a href="/product-category/wholesale-cardboard-boxes/">Volume price breaks</a>'],
      ['<strong>Printing</strong>', 'Run length first, artwork type second', '<a href="/resources/custom-box-printing-methods/">Printing methods</a>'],
      ['<strong>Finish</strong>', 'How the box should feel, and recyclability', '<a href="/resources/recyclable-cardboard-packaging/">Recyclable packaging</a>'],
    ])}
  </section>

  <section class="scb-section">
    <h2>The structures you can configure</h2>
    <p>Six base structures cover most of what we make. They differ in how they close, whether they ship flat, and what they cost per unit.</p>
    ${boxStyles()}
    <p>If your product needs a structure that is not here — a gable top, a hexagon, a sleeve over a tray — say so in the notes step and we will build it. The configurator covers the common cases rather than every dieline we hold.</p>
  </section>

  <section class="scb-section scb-tinted">
    <h2>What happens after you send it</h2>
    <ol>
      <li><strong>A specialist reads the specification.</strong> Not a script — a person who quotes these boxes daily and will tell you if something in the combination does not work.</li>
      <li><strong>You get pricing, usually within one working day.</strong> With board options where there is a sensible cheaper alternative.</li>
      <li><strong>We produce the dieline free of charge,</strong> and your designer works to it — or ours does, also free.</li>
      <li><strong>You approve a proof.</strong> Digital for content and placement; printed if colour accuracy matters to the launch.</li>
      <li><strong>Production runs 8–10 business days</strong> from artwork approval, with delivery included anywhere in the United States.</li>
    </ol>
    ${linkRow([
      { path: '/products/', label: 'Browse all 186 box styles' },
      { path: '/resources/', label: 'Read the packaging guides' },
      { path: '/product-category/wholesale-cardboard-boxes/', label: 'Volume pricing' },
      { path: '/contact-us/', label: 'Talk to someone instead' },
    ])}
  </section>

  ${faqHtml(FAQS, 'Questions about the configurator')}
  ${cta('Would rather just talk it through?', 'Send us the product and roughly what you need. A specialist will work through the specification with you and quote it.', [{ path: '/contact-us/', label: 'Contact a specialist' }, { path: '/resources/', label: 'Read the guides first', kind: 'ghost' }])}
</div>`;

const snapshot = toSnapshot({
  path,
  title: 'Design Your Box | Custom Cardboard Box Configurator',
  description: 'Configure a custom cardboard box step by step — structure, size, board, printing and finish — and send the specification for a real quote from a packaging specialist.',
  contentHtml,
  bodyClass: 'scb-configurator-page',
  jsonLd: [
    breadcrumbJsonLd(crumbs),
    faqJsonLd(FAQS, path),
    JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      '@id': `${abs(path)}#webpage`,
      url: abs(path),
      name: 'Design Your Box',
      description: 'A step-by-step configurator for specifying a custom cardboard box.',
      isPartOf: { '@type': 'WebSite', name: 'Shop Cardboard Boxes', url: abs('/') },
    }),
  ],
});
---

<BaseLayout snapshot={snapshot}>
  <Fragment set:html={snapshot.contentHtml} />
</BaseLayout>
