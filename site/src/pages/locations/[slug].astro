---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { toSnapshot } from '../../lib/seo/chrome';
import { locationBySlug, LOCATIONS } from '../../data/seo/locations';
import { breadcrumbHtml, breadcrumbJsonLd, faqHtml, faqJsonLd, esc, abs } from '../../lib/seo/util';
import { quoteForm, cta, navCards } from '../../lib/seo/blocks';
import { configurator } from '../../lib/seo/configurator';

const slug = Astro.params.slug ?? '';
const location = locationBySlug.get(slug);
if (!location) return Astro.rewrite('/404');

const path = `/locations/${location.slug}/`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Where we ship', path: '/locations/' },
  ...(location.stateSlug && LOCATIONS.some((entry) => entry.slug === location.stateSlug)
    ? [{ name: location.stateName as string, path: `/locations/${location.stateSlug}/` }]
    : []),
  { name: location.name, path },
];

// The note and the closing call to action are taken from copy written for this
// page, so no two of the forty carry the same sentence.
const form = quoteForm({
  heading: location.cta.heading,
  note: location.cta.body,
  buttonLabel: location.cta.label,
  formName: `Quote — ${location.name}`,
});

const facts = location.facts?.length
  ? `<ul class="scb-intro-facts">${location.facts.map((fact) => `<li><strong>${esc(fact.value)}</strong>${esc(fact.label)}</li>`).join('')}</ul>`
  : '';

const sectionsHtml = location.sections.map((section, index) => `<section class="scb-section${index % 2 === 1 ? ' scb-tinted' : ''}"><h2>${esc(section.h2)}</h2>${section.html}</section>`).join('');

// Where the form sits varies by page so the forty pages do not share one skeleton.
const formInHero = location.layout === 'form-in-hero';
const formAfterFirst = location.layout === 'form-after-first-section';

const firstSection = location.sections.length
  ? `<section class="scb-section"><h2>${esc(location.sections[0].h2)}</h2>${location.sections[0].html}</section>`
  : '';
const restSections = location.sections.slice(1).map((section, index) => `<section class="scb-section${index % 2 === 0 ? ' scb-tinted' : ''}"><h2>${esc(section.h2)}</h2>${section.html}</section>`).join('');

const formBlock = `<section class="scb-section scb-tinted"><div style="max-width:620px">${form}</div></section>`;

const body = formAfterFirst
  ? `${firstSection}${formBlock}${restSections}`
  : sectionsHtml;

const hasStatePage = location.kind === 'city' && location.stateSlug && LOCATIONS.some((entry) => entry.slug === location.stateSlug);
/**
 * Each location page reached the rest of the set only through the hub, which left
 * forty pages holding a single inbound link each. Link the cluster instead: a city
 * to the others in its state and then its region, a state to the cities we cover in
 * it and then its neighbours. Navigation only — none of it claims a local presence.
 */
/** What kind of page a link leads to, so the card can say so. */
const kindOf = (path: string): string =>
  path.startsWith('/resources/') ? 'Packaging guide'
  : path.startsWith('/product-category/') ? 'Product category'
  : path.startsWith('/product/') ? 'Product'
  : path.startsWith('/locations/') ? 'Location'
  : 'Page';

const others = LOCATIONS.filter((entry) => entry.slug !== location.slug);
const sameState = others.filter((entry) => entry.kind === 'city' && entry.stateSlug === (location.kind === 'state' ? location.slug : location.stateSlug));
const sameRegion = others.filter((entry) => entry.region === location.region && !sameState.includes(entry) && entry.kind === (location.kind === 'state' ? 'state' : 'city'));
const nearbyLinks = [...sameState, ...sameRegion].slice(0, 6).map((entry) => ({ path: `/locations/${entry.slug}/`, label: entry.name, note: `${entry.eyebrow} · ${entry.region}` }));
const nearby = nearbyLinks.length
  ? `<section class="scb-section scb-tinted">
      <h2>Other places we ship to</h2>
      ${navCards([...nearbyLinks, { path: '/locations/', label: 'All 40 locations', note: 'Every state and city we ship to' }])}
    </section>`
  : '';

const onward = `<section class="scb-section">
  <h2>${hasStatePage ? `Beyond ${esc(location.name)}` : `The rest of ${esc(location.name)}'s packaging questions`}</h2>
  <p>${hasStatePage
    ? `The <a href="/locations/${esc(location.stateSlug || "")}/">${esc(location.stateName || '')} page</a> covers what applies across the state rather than to ${esc(location.name)} specifically, and these are the products and guides ${esc(location.name)} customers open most.`
    : `${esc(location.summary)} These are the products and guides that answer them.`}</p>
  ${navCards([...location.shop, ...location.guides].map((link) => ({ path: link.path, label: link.label, note: kindOf(link.path) })))}
</section>`;

const cfgBlock = `<section class="scb-section scb-cfg-section">
  <h2>Specify your boxes</h2>
  <p class="scb-lede">Four steps to a brief we can price — structure and size, board, printing, and where to send the quote. Nothing is billed and no card is needed.</p>
  ${configurator({ prefix: 'lcfg', compact: true })}
</section>`;

const contentHtml = `<div class="site-content">
  <div class="scb-intro">
    <div class="scb-intro-inner">
      <div>
        ${breadcrumbHtml(crumbs)}
        <span class="scb-eyebrow">${esc(location.eyebrow)}</span>
        <h1>${esc(location.h1)}</h1>
        ${location.lede}
        ${facts}
      </div>
      <div>${formInHero ? form : ''}</div>
    </div>
  </div>
  ${body}
  ${faqHtml(location.faqs, location.faqHeading)}
  ${onward}
  ${cfgBlock}
  ${nearby}
  ${location.layout === 'form-at-end' ? formBlock : ''}
  ${cta(location.cta.heading, esc(location.cta.body), [{ path: '/contact-us/', label: location.cta.label }, { path: '/design-your-box/', label: 'Design your box', kind: 'ghost' }])}
</div>`;

const snapshot = toSnapshot({
  path,
  title: location.title,
  description: location.description,
  contentHtml,
  bodyClass: `scb-location scb-location-${location.kind}`,
  // No LocalBusiness schema: there is no branch, address or phone number in this
  // location, and claiming one would be a fabrication.
  jsonLd: [
    breadcrumbJsonLd(crumbs),
    faqJsonLd(location.faqs, path),
    JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      '@id': `${abs(path)}#webpage`,
      url: abs(path),
      name: location.h1,
      description: location.description,
      isPartOf: { '@type': 'WebSite', name: 'Shop Cardboard Boxes', url: abs('/') },
      about: { '@type': 'Thing', name: `Cardboard packaging for ${location.name}` },
    }),
  ],
});
---

<BaseLayout snapshot={snapshot}>
  <Fragment set:html={snapshot.contentHtml} />
</BaseLayout>
