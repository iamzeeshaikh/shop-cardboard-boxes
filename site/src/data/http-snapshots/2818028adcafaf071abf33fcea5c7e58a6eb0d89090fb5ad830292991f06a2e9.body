D&amp;tax_query%5B0%5D%5Btaxonomy%5D=product_visibility&amp;tax_query%5B0%5D%5Bfield%5D=name&amp;tax_query%5B0%5D%5Bterms%5D%5B0%5D=exclude-from-search&amp;tax_query%5B0%5D%5Bterms%5D%5B1%5D=exclude-from-catalog&amp;tax_query%5B0%5D%5Boperator%5D=NOT+IN&amp;tax_query%5B1%5D%5Btaxonomy%5D=product_cat&amp;tax_query%5B1%5D%5Bfield%5D=slug&amp;tax_query%5B1%5D%5Bterms%5D%5B0%5D=cardboard-boxes-by-functionality&amp;tax_query%5B1%5D%5Bterms%5D%5B1%5D=cardboard-boxes-by-material-strength&amp;tax_query%5B1%5D%5Bterms%5D%5B2%5D=cardboard-boxes-by-size-and-shape&amp;tax_query%5B1%5D%5Bterms%5D%5B3%5D=cardboard-boxes-for-specific-uses&amp;tax_query%5B1%5D%5Bterms%5D%5B4%5D=cosmetic-and-gift-cardboard-boxes&amp;tax_query%5B1%5D%5Bterms%5D%5B5%5D=food-related-cardboard-boxes&amp;tax_query%5B1%5D%5Bterms%5D%5B6%5D=packaging-for-specific-items&amp;tax_query%5B1%5D%5Boperator%5D=IN&amp;meta_query%5Brelation%5D=AND&amp;orderby=date&amp;total_post=186\" data-max-page=\"2\">\n                    <span class=\"eael-btn-loader button__loader\"><\/span>\n                    <span class=\"eael_load_more_text\"><\/span>\n                <\/button>\n            <\/div>\n                        <\/div>\n        <\/div>\n\n        <script type=\"text\/javascript\">\n            jQuery(document).ready(function($) {\n                var $scope = jQuery(\".elementor-element-be454ed\");\n                var $products = $('.products', $scope);\n                var $layout_mode = $products.data('layout-mode');\n                \n                if ( $layout_mode === 'masonry' ) {\n                    \/\/ init isotope\n                    var $isotope_products = $products.isotope({\n                        itemSelector: \"li.product\",\n                        layoutMode: $layout_mode,\n                        percentPosition: true\n                    });\n\n                    $isotope_products.imagesLoaded().progress( function() {\n                        $isotope_products.isotope('layout');\n                    })\n                    \n                }\n            });\n        <\/script>\n        \t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-f893008 e-con-full e-flex e-con e-parent\" data-id=\"f893008\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-81ccbb5 elementor-widget elementor-widget-text-editor\" data-id=\"81ccbb5\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<h2><span style=\"font-weight: 400;\">Premium Cardboard Packing Boxes for Every Packaging Need<\/span><\/h2><p><span style=\"font-weight: 400;\">Shop Cardboard Boxes understands that packaging is not only a box. It plays an important role in leaving a lasting impression on your customers\u2019 minds. Our custom <\/span><b>cardboard packing boxes<\/b><span style=\"font-weight: 400;\"> are designed to make your products more appealing. It offers a mixture of durability, adaptability, and design. We offer our valued clients with a broad collection of boxes ranging from Christmas cardboard boxes to cardboard bakery boxes.<\/span><\/p><h2><span style=\"font-weight: 400;\">Quality and Customization You Can Rely On<\/span><\/h2><p><span style=\"font-weight: 400;\">Our cardboard packing boxes come in strong materials. It guarantees the protection for your products and packages or for your gift packaging or retail packaging purposes. Our range includes our own designs of special cardboard boxes with printing as well.\u00a0<\/span><\/p><p><span style=\"font-weight: 400;\">Shop Cardboard Boxes company provides all types of solutions to its customers, especially in terms of their packaging materials ranging from the bulk cardboard boxes to the individually customized packages.<\/span><\/p><h2><span style=\"font-weight: 400;\">High-Quality Cardboard Packaging Boxes for Every Use<\/span><\/h2><p><span style=\"font-weight: 400;\">Our cardboard boxes come in a variety of designs, styles, and finishes that cater to different uses across industries. Let us explore the categories that make these boxes the preferred choice for packaging:<\/span><\/p><h2><span style=\"font-weight: 400;\">Food-Safe Cardboard Packaging for Freshness<\/span><\/h2><p><span style=\"font-weight: 400;\">We cater for our take out food packaging requirements and ensure that your food is fresh and well protected. Our boxes ensure that your products look great.<\/span><\/p><ul><li style=\"font-weight: 400;\" aria-level=\"1\"><a href=\"https:\/\/shopcardboardboxes.com\/product\/cardboard-bakery-boxes\/\"><span style=\"font-weight: 400;\">Cardboard Bakery Boxes<\/span><\/a><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Cardboard Snack Boxes<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Cardboard Burger Boxes<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Lunch Cardboard Boxes<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Cardboard Pizza Boxes<\/span><\/li><\/ul><h2><span style=\"font-weight: 400;\">Strength and Durability of Every Box<\/span><\/h2><p><span style=\"font-weight: 400;\">The boxes in our collection range from single-wall, double-wall, and triple-wall boxes. These boxes protect your products during shipping and transportation..<\/span><\/p><ul><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Single Wall Cardboard Boxes<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Double Wall Cardboard Boxes<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Triple Wall Cardboard Boxes<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><a href=\"https:\/\/shopcardboardboxes.com\/product\/corrugated-cardboard-boxes\/\"><span style=\"font-weight: 400;\">Corrugated Cardboard Boxes<\/span><\/a><\/li><\/ul><h2><span style=\"font-weight: 400;\">Add a Pop of Color with Our Vibrant Selection<\/span><\/h2><p><span style=\"font-weight: 400;\">Choosing from our vibrant ones will keep up with your brand\u2019s distinct appearance. Our <\/span><b>colored cardboard boxes <\/b><span style=\"font-weight: 400;\">include the black, pink, and many more colors.<\/span><\/p><ul><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Black Cardboard Boxes<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">White Cardboard Boxes<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><a href=\"https:\/\/shopcardboardboxes.com\/product\/pink-cardboard-boxes\/\"><span style=\"font-weight: 400;\">Pink Cardboard Boxes<\/span><\/a><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Blank Cardboard Boxes<\/span><\/li><\/ul><h2><span style=\"font-weight: 400;\">Customization Options to Match Every Style and Need<\/span><\/h2><h3><span style=\"font-weight: 400;\">Coating Finishes to Uplift Your Packaging Experience<\/span><\/h3><p><span style=\"font-weight: 400;\">Select from among our range of available finishes. Every layer gives your cardboard boxes a unique touch making them superior quality and look better.<\/span><\/p><ul><li style=\"font-weight: 400;\" aria-level=\"1\"><b>Matte Coating:<\/b><span style=\"font-weight: 400;\"> This coating is not shiny and hides imperfections to give the wall an elegant look.<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><b>Gloss Coating:<\/b><span style=\"font-weight: 400;\"> It helps to increase the shine of the material, colors becomes bright, more expressive.<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><b>Spot UV: <\/b><span style=\"font-weight: 400;\">It highlights specific areas focusing on high-shine effect.<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><b>Soft-Touch Coating:<\/b><span style=\"font-weight: 400;\"> Furthermore, it includes smooth, rich, extremely comforting, and a pleasing look.<\/span><\/li><\/ul><h2><span style=\"font-weight: 400;\">Stand-Out Printing Options for Your Unique Vision<\/span><\/h2><p><span style=\"font-weight: 400;\">Our high quality print service help your creative designs come alive today. Our boxes come in full color. We create an exclusive design for your specific packaging needs. Moreover, other extra features include foil stamping and glossy embossing to make your packaging stand out.<\/span><\/p><ol><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Custom Printed Cardboard Packaging<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Foil Stamping and Embossing<\/span><\/li><\/ol><h2><span style=\"font-weight: 400;\">Shapes and Sizes to Fit Every Product<\/span><\/h2><p><span style=\"font-weight: 400;\">Shop Cardboard Boxes understands that not one shape and size is suitable for every business and product. There are various shapes and sizes of boxes. You can select the shape and size from the following as per your requirements.<\/span><\/p><ul><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Large Cardboard Boxes<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Cube Cardboard Boxes<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Hexagon Cardboard Boxes<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><a href=\"https:\/\/shopcardboardboxes.com\/product\/tiny-cardboard-boxes\/\"><span style=\"font-weight: 400;\">Tiny Cardboard Boxes<\/span><\/a><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Rectangle Cardboard Boxes<\/span><\/li><\/ul><h2><span style=\"font-weight: 400;\">Custom Cardboard Boxes for Special Occasions<\/span><\/h2><p><span style=\"font-weight: 400;\">Our collection also includes specialty packaging designed for unique events and memorable experiences. Our fancy cardboard boxes, Christmas boxes, and decorative boxes help add charm to every celebration.<\/span><\/p><p><span style=\"font-weight: 400;\">We have special packaging dedicated to any event and an unforgettable experience. They include fancy, Christmas, and decorative boxes.These boxes add charm in the celebrations.<\/span><\/p><ul><li style=\"font-weight: 400;\" aria-level=\"1\"><a href=\"https:\/\/shopcardboardboxes.com\/product\/decorative-cardboard-boxes\/\"><span style=\"font-weight: 400;\">Decorative Cardboard Boxes<\/span><\/a><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Christmas Cardboard Boxes<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Fancy Cardboard Boxes<\/span><\/li><\/ul><h2><span style=\"font-weight: 400;\">Eco-Friendly Packaging for a Sustainable Future<\/span><\/h2><p><span style=\"font-weight: 400;\">We also show our concern on environmental issues by providing cardboard boxes made out of recyclable, and biodegradable material. Besides lowering the costs, environmentally friendly packs are also acceptable to customers who have concerns of the environment. This simply means that when you decide to choose <\/span><b>Shop Cardboard Boxes<\/b><span style=\"font-weight: 400;\"> you will be assured of quality at the same time enjoying the benefits of going green.<\/span><\/p><h2><span style=\"font-weight: 400;\">Specific Use of Custom Cardboard Boxes\u00a0<\/span><\/h2><p><span style=\"font-weight: 400;\">We specialize in creating several different cardboard boxes. It makes it easier for you to find what you need, when you need it. Here our products include specialty boxes and packages, jewels, cosmetics, ornaments, etc.<\/span><\/p><h3><span style=\"font-weight: 400;\">Cardboard Storage and Postal Solutions<\/span><\/h3><p><span style=\"font-weight: 400;\">Our storage and postal boxes also have a feature of providing security of the material used in storage and shipping. It comes in with lids, handles, and in some, you can order the customized shape of the box to fit certain items if need be.<\/span><\/p><ul><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Cardboard Storage Boxes<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Cardboard Postal Boxes<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><a href=\"https:\/\/shopcardboardboxes.com\/product\/cardboard-boxes-with-lid\/\"><span style=\"font-weight: 400;\">Cardboard Boxes with Lid<\/span><\/a><\/li><\/ul><h3><span style=\"font-weight: 400;\">Gift and Presentation Packaging<\/span><\/h3><p><span style=\"font-weight: 400;\">Our range of boxes includes gift, ring, and presentation packaging to increase the appeal of gifts. The personalized printing and the fine designs are ideal for making every gift wrapped in this box look special.<\/span><\/p><ul><li style=\"font-weight: 400;\" aria-level=\"1\"><a href=\"https:\/\/shopcardboardboxes.com\/product\/cardboard-gift-boxes\/\"><span style=\"font-weight: 400;\">Cardboard Gift Boxes<\/span><\/a><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Cardboard Presentation Boxes<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Cardboard Boxes with Window<\/span><\/li><\/ul><h2><span style=\"font-weight: 400;\">Unique Cardboard Designs and Styles to Make a Statement<\/span><\/h2><p><span style=\"font-weight: 400;\">Shop Cardboard Boxes also provides folding and foldable boxes. These types of boxes take less space and are also easier to set up. They are also very useful to businesses that have limited space that they can use to store the items contained in these boxes.<\/span><\/p><ul><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Folding Cardboard Boxes<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Foldable Cardboard Boxes<\/span><\/li><\/ul><p><span style=\"font-weight: 400;\">We have cardboard cosmetic packaging, cardboard candle boxes, and many other products for those who consider themselves classy. They are designed to revolutionize your product line by giving it a classy look.<\/span><\/p><h2><span style=\"font-weight: 400;\">Attractive Colors To Make Your Packaging More Attractive<\/span><\/h2><p><span style=\"font-weight: 400;\">Colors play an important role to make your products more appealing and increase your sales.<\/span><\/p><p><span style=\"font-weight: 400;\">Shop Cardboard Boxes offers the following color schemes:<\/span><\/p><ul><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Four Color Model (Cyan, Magenta, Yellow, and Black)<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Pantone Matching System (Wide range of colors)<\/span><\/li><\/ul><h2><span style=\"font-weight: 400;\">Printing Techniques To Showcase Your Brand Uniquely<\/span><\/h2><ul><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Digital Printing<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Offset Printing<\/span><\/li><\/ul><h2><span style=\"font-weight: 400;\">Our Sampling Options\u00a0<\/span><\/h2><ul><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">2D Inspection<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">3D Mockup<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Physical Samples<\/span><\/li><\/ul><h2><span style=\"font-weight: 400;\">Eco-Friendly Packaging for Conscious Consumers<\/span><\/h2><p><span style=\"font-weight: 400;\">Our cardboard boxes are not only functional and attractive. They are also environmentally friendly. These packaging add value to the products. You can create a sustainable environment even as you create value for your customers with our biodegradable materials.<\/span><\/p><h2><span style=\"font-weight: 400;\">Why Choose Shop Cardboard Boxes?<\/span><\/h2><p><span style=\"font-weight: 400;\">Shop Cardboard Boxes offers you a variety of cardboard boxes to meet your packaging needs.\u00a0<\/span><\/p><ul><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">24\/7 Availability<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Free Services (Shipping, Design &amp; Consultation)<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Affordable Pricing<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Quick Turnaround Times<\/span><\/li><\/ul><p><span style=\"font-weight: 400;\">Get in touch with us via email at <\/span><a href=\"mailto:info@shopcardboardboxes.com\"><span style=\"font-weight: 400;\">info@shopcardboardboxes.com<\/span><\/a><span style=\"font-weight: 400;\"> or by phone call at <a href=\"tel:+15033580443\"><span class=\"elementor-icon-list-text\"><b>+1 (503) 358-0443<\/b><\/span><\/a>.<\/span><\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-fc5d143 e-con-full e-flex e-con e-parent\" data-id=\"fc5d143\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-3103a8f elementor-widget elementor-widget-html\" data-id=\"3103a8f\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<!-- \u2705 SHOPCARDBOARDBOXES.COM \u2014 HOW IT WORKS (Catchy + Icons + CWV-safe)\r\nPaste into Elementor > HTML widget\r\n\r\nRequested updates:\r\n- Shop Now: https:\/\/shopcardboardboxes.com\/products\/\r\n- Get Quote: https:\/\/shopcardboardboxes.com\/contact-us\/\r\n- Removed: browse \/ shipping links\r\n- Color scheme: #dcae60 + black + white\r\n- More beautiful + catchy (still lightweight; no external libs; no JS)\r\n-->\r\n\r\n<section class=\"scb-how\" aria-label=\"How ordering cardboard boxes works\">\r\n  <div class=\"scb-container\">\r\n\r\n    <!-- Header -->\r\n    <header class=\"scb-header\">\r\n      <span class=\"scb-pill\">\r\n        <span class=\"scb-pillIcon\" aria-hidden=\"true\">\r\n          <!-- sparkle icon -->\r\n          <svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\">\r\n            <path d=\"M12 2l1.1 4.2L17 7.3l-3.9 1.1L12 12l-1.1-3.6L7 7.3l3.9-1.1L12 2Z\"\r\n              stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linejoin=\"round\"\/>\r\n            <path d=\"M19 12l.7 2.5L22 15l-2.3.5L19 18l-.7-2.5L16 15l2.3-.5L19 12Z\"\r\n              stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linejoin=\"round\"\/>\r\n          <\/svg>\r\n        <\/span>\r\n        Fast ordering for shipping, storage, and custom packaging\r\n      <\/span>\r\n\r\n      <h2>How It Works<\/h2>\r\n      <p>\r\n        Pick your box style, choose the right size, and order in minutes. Need branded packaging?\r\n        Request a quote and we\u2019ll help you finalize the best option.\r\n      <\/p>\r\n    <\/header>\r\n\r\n    <!-- Steps -->\r\n    <div class=\"scb-grid\" role=\"list\">\r\n\r\n      <!-- STEP 1 -->\r\n      <article class=\"scb-card\" role=\"listitem\">\r\n        <div class=\"scb-top\">\r\n          <div class=\"scb-icon\" aria-hidden=\"true\">\r\n            <!-- Box icon -->\r\n            <svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\">\r\n              <path d=\"M3.5 7.5 12 3l8.5 4.5L12 12 3.5 7.5Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"\/>\r\n              <path d=\"M3.5 7.5V17L12 21l8.5-4V7.5\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"\/>\r\n              <path d=\"M12 12v9\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"\/>\r\n            <\/svg>\r\n          <\/div>\r\n\r\n          <div class=\"scb-meta\">\r\n            <span class=\"scb-step\">Step 1<\/span>\r\n            <h3>Choose Your Box Type<\/h3>\r\n          <\/div>\r\n        <\/div>\r\n\r\n        <ul class=\"scb-list\">\r\n          <li>\r\n            <span class=\"scb-check\" aria-hidden=\"true\">\r\n              <svg viewBox=\"0 0 24 24\"><path d=\"M5 12l4 4 10-10\" stroke=\"currentColor\" stroke-width=\"2.2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/><\/svg>\r\n            <\/span>\r\n            Select from shipping, mailer, moving, and storage boxes\r\n          <\/li>\r\n          <li>\r\n            <span class=\"scb-check\" aria-hidden=\"true\">\r\n              <svg viewBox=\"0 0 24 24\"><path d=\"M5 12l4 4 10-10\" stroke=\"currentColor\" stroke-width=\"2.2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/><\/svg>\r\n            <\/span>\r\n            Pick a size that fits your product and packing style\r\n          <\/li>\r\n          <li>\r\n            <span class=\"scb-check\" aria-hidden=\"true\">\r\n              <svg viewBox=\"0 0 24 24\"><path d=\"M5 12l4 4 10-10\" stroke=\"currentColor\" stroke-width=\"2.2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/><\/svg>\r\n            <\/span>\r\n            Choose the right strength for safe handling\r\n          <\/li>\r\n        <\/ul>\r\n      <\/article>\r\n\r\n      <!-- STEP 2 -->\r\n      <article class=\"scb-card scb-cardAccent\" role=\"listitem\">\r\n        <div class=\"scb-top\">\r\n          <div class=\"scb-icon\" aria-hidden=\"true\">\r\n            <!-- Ruler \/ customize icon -->\r\n            <svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\">\r\n              <path d=\"M4 20 20 4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"\/>\r\n              <path d=\"M7 17l-2-2M10 14l-2-2M13 11l-2-2M16 8l-2-2\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"\/>\r\n              <path d=\"M6.5 21.5 2.5 17.5 17.5 2.5 21.5 6.5 6.5 21.5Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"\/>\r\n            <\/svg>\r\n          <\/div>\r\n\r\n          <div class=\"scb-meta\">\r\n            <span class=\"scb-step\">Step 2<\/span>\r\n            <h3>Order Standard or Customize<\/h3>\r\n          <\/div>\r\n        <\/div>\r\n\r\n        <ul class=\"scb-list\">\r\n          <li>\r\n            <span class=\"scb-check\" aria-hidden=\"true\">\r\n              <svg viewBox=\"0 0 24 24\"><path d=\"M5 12l4 4 10-10\" stroke=\"currentColor\" stroke-width=\"2.2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/><\/svg>\r\n            <\/span>\r\n            Place a quick order for standard boxes\r\n          <\/li>\r\n          <li>\r\n            <span class=\"scb-check\" aria-hidden=\"true\">\r\n              <svg viewBox=\"0 0 24 24\"><path d=\"M5 12l4 4 10-10\" stroke=\"currentColor\" stroke-width=\"2.2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/><\/svg>\r\n            <\/span>\r\n            Request custom sizing for a perfect fit\r\n          <\/li>\r\n          <li>\r\n            <span class=\"scb-check\" aria-hidden=\"true\">\r\n              <svg viewBox=\"0 0 24 24\"><path d=\"M5 12l4 4 10-10\" stroke=\"currentColor\" stroke-width=\"2.2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/><\/svg>\r\n            <\/span>\r\n            Add printing options for branded packaging\r\n          <\/li>\r\n        <\/ul>\r\n      <\/article>\r\n\r\n      <!-- STEP 3 -->\r\n      <article class=\"scb-card\" role=\"listitem\">\r\n        <div class=\"scb-top\">\r\n          <div class=\"scb-icon\" aria-hidden=\"true\">\r\n            <!-- Shield \/ quality icon -->\r\n            <svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\">\r\n              <path d=\"M12 3 20 7v6c0 5-3.4 8.1-8 9-4.6-.9-8-4-8-9V7l8-4Z\"\r\n                stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"\/>\r\n              <path d=\"M8.5 12.2 11 14.6l4.8-5\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/>\r\n            <\/svg>\r\n          <\/div>\r\n\r\n          <div class=\"scb-meta\">\r\n            <span class=\"scb-step\">Step 3<\/span>\r\n            <h3>Confirm and Receive<\/h3>\r\n          <\/div>\r\n        <\/div>\r\n\r\n        <ul class=\"scb-list\">\r\n          <li>\r\n            <span class=\"scb-check\" aria-hidden=\"true\">\r\n              <svg viewBox=\"0 0 24 24\"><path d=\"M5 12l4 4 10-10\" stroke=\"currentColor\" stroke-width=\"2.2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/><\/svg>\r\n            <\/span>\r\n            We confirm your order details and quantity\r\n          <\/li>\r\n          <li>\r\n            <span class=\"scb-check\" aria-hidden=\"true\">\r\n              <svg viewBox=\"0 0 24 24\"><path d=\"M5 12l4 4 10-10\" stroke=\"currentColor\" stroke-width=\"2.2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/><\/svg>\r\n            <\/span>\r\n            Boxes are prepared with quality checks\r\n          <\/li>\r\n          <li>\r\n            <span class=\"scb-check\" aria-hidden=\"true\">\r\n              <svg viewBox=\"0 0 24 24\"><path d=\"M5 12l4 4 10-10\" stroke=\"currentColor\" stroke-width=\"2.2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/><\/svg>\r\n            <\/span>\r\n            Delivery is arranged based on your location\r\n          <\/li>\r\n        <\/ul>\r\n      <\/article>\r\n\r\n    <\/div>\r\n\r\n    <!-- CTA -->\r\n    <div class=\"scb-cta\">\r\n      <div class=\"scb-ctaLeft\">\r\n        <h3>\r\n          <span class=\"scb-ctaIcon\" aria-hidden=\"true\">\r\n            <!-- lightning icon -->\r\n            <svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\">\r\n              <path d=\"M13 2 4 14h7l-1 8 10-14h-7l0-6Z\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linejoin=\"round\"\/>\r\n            <\/svg>\r\n          <\/span>\r\n          Ready to order cardboard boxes?\r\n        <\/h3>\r\n        <p>Shop standard sizes now, or request a quote for custom requirements.<\/p>\r\n      <\/div>\r\n\r\n      <div class=\"scb-ctaBtns\">\r\n        <a class=\"scb-btn scb-btnPrimary\" href=\"https:\/\/shopcardboardboxes.com\/products\/\">Shop Now<\/a>\r\n        <a class=\"scb-btn scb-btnOutline\" href=\"https:\/\/shopcardboardboxes.com\/contact-us\/\">Get Quote<\/a>\r\n      <\/div>\r\n    <\/div>\r\n\r\n  <\/div>\r\n<\/section>\r\n\r\n<style>\r\n  \/* ==========================\r\n     SCB Color Scheme\r\n     Gold: #dcae60\r\n     Black: #0b0b0b\r\n     White: #ffffff\r\n     ========================== *\/\r\n\r\n  .scb-how{\r\n    padding: clamp(30px, 4vw, 72px) 0;\r\n    background:\r\n      radial-gradient(900px 420px at 12% 10%, rgba(220,174,96,0.18), transparent 55%),\r\n      radial-gradient(700px 360px at 92% 20%, rgba(220,174,96,0.12), transparent 55%),\r\n      linear-gradient(180deg, rgba(0,0,0,0.02), transparent 70%);\r\n  }\r\n\r\n  .scb-container{\r\n    width: min(1120px, calc(100% - 32px));\r\n    margin: 0 auto;\r\n  }\r\n\r\n  .scb-header{\r\n    max-width: 820px;\r\n    margin: 0 auto 22px;\r\n    text-align: left;\r\n  }\r\n\r\n  .scb-pill{\r\n    display: inline-flex;\r\n    align-items: center;\r\n    gap: 8px;\r\n    padding: 7px 12px;\r\n    border-radius: 999px;\r\n    background: rgba(220,174,96,0.14);\r\n    border: 1px solid rgba(220,174,96,0.35);\r\n    color: #0b0b0b;\r\n    font-size: 13px;\r\n    line-height: 1;\r\n    margin-bottom: 12px;\r\n  }\r\n  .scb-pillIcon{\r\n    width: 26px;\r\n    height: 26px;\r\n    border-radius: 999px;\r\n    display: grid;\r\n    place-items: center;\r\n    background: rgba(255,255,255,0.9);\r\n    border: 1px solid rgba(220,174,96,0.35);\r\n    color: #0b0b0b;\r\n  }\r\n\r\n  .scb-header h2{\r\n    margin: 0 0 10px;\r\n    font-size: clamp(22px, 2.8vw, 38px);\r\n    line-height: 1.12;\r\n    letter-spacing: -0.02em;\r\n    color: #0b0b0b;\r\n  }\r\n  .scb-header p{\r\n    margin: 0;\r\n    font-size: 16px;\r\n    line-height: 1.65;\r\n    color: rgba(11,11,11,0.82);\r\n  }\r\n\r\n  .scb-grid{\r\n    display: grid;\r\n    grid-template-columns: 1fr;\r\n    gap: 14px;\r\n    margin-top: 18px;\r\n  }\r\n\r\n  .scb-card{\r\n    background: #ffffff;\r\n    border: 1px solid rgba(11,11,11,0.10);\r\n    border-radius: 18px;\r\n    padding: 18px;\r\n    box-shadow: 0 12px 32px rgba(0,0,0,0.06);\r\n    position: relative;\r\n    overflow: hidden;\r\n  }\r\n\r\n  \/* Accent card to create visual rhythm *\/\r\n  .scb-cardAccent{\r\n    border-color: rgba(220,174,96,0.45);\r\n    box-shadow: 0 14px 40px rgba(220,174,96,0.18);\r\n  }\r\n  .scb-cardAccent::before{\r\n    content:\"\";\r\n    position:absolute;\r\n    inset:-2px;\r\n    background: radial-gradient(700px 240px at 10% 10%, rgba(220,174,96,0.22), transparent 55%);\r\n    pointer-events:none;\r\n  }\r\n\r\n  .scb-top{\r\n    display: flex;\r\n    gap: 12px;\r\n    align-items: flex-start;\r\n    margin-bottom: 10px;\r\n    position: relative;\r\n    z-index: 1;\r\n  }\r\n\r\n  .scb-icon{\r\n    width: 48px;\r\n    height: 48px;\r\n    border-radius: 16px;\r\n    display: grid;\r\n    place-items: center;\r\n    background: rgba(220,174,96,0.12);\r\n    border: 1px solid rgba(220,174,96,0.35);\r\n    color: #0b0b0b;\r\n    flex: 0 0 auto;\r\n  }\r\n\r\n  .scb-meta{\r\n    min-width: 0;\r\n  }\r\n\r\n  .scb-step{\r\n    display: inline-block;\r\n    font-size: 12px;\r\n    font-weight: 800;\r\n    letter-spacing: 0.02em;\r\n    color: rgba(11,11,11,0.62);\r\n    margin-bottom: 4px;\r\n  }\r\n\r\n  .scb-card h3{\r\n    margin: 0;\r\n    font-size: 18px;\r\n    line-height: 1.25;\r\n    color: #0b0b0b;\r\n  }\r\n\r\n  .scb-list{\r\n    list-style: none;\r\n    padding: 0;\r\n    margin: 12px 0 0;\r\n    position: relative;\r\n    z-index: 1;\r\n  }\r\n  .scb-list li{\r\n    display: grid;\r\n    grid-template-columns: 18px 1fr;\r\n    gap: 10px;\r\n    align-items: start;\r\n    margin: 9px 0;\r\n    line-height: 1.6;\r\n    color: rgba(11,11,11,0.84);\r\n  }\r\n\r\n  .scb-check{\r\n    width: 18px;\r\n    height: 18px;\r\n    display: grid;\r\n    place-items: center;\r\n    color: #dcae60;\r\n    margin-top: 2px;\r\n  }\r\n  .scb-check svg{ width: 18px; height: 18px; }\r\n\r\n  .scb-cta{\r\n    margin-top: 16px;\r\n    border-radius: 20px;\r\n    padding: 18px;\r\n    background: #0b0b0b;\r\n    color: #ffffff;\r\n    border: 1px solid rgba(220,174,96,0.35);\r\n    display: grid;\r\n    gap: 12px;\r\n    box-shadow: 0 18px 44px rgba(0,0,0,0.18);\r\n  }\r\n\r\n  .scb-ctaLeft h3{\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 10px;\r\n    margin: 0 0 6px;\r\n    font-size: 18px;\r\n    line-height: 1.25;\r\n  }\r\n\r\n  .scb-ctaIcon{\r\n    width: 34px;\r\n    height: 34px;\r\n    border-radius: 999px;\r\n    display: grid;\r\n    place-items: center;\r\n    background: rgba(220,174,96,0.14);\r\n    border: 1px solid rgba(220,174,96,0.35);\r\n    color: #dcae60;\r\n    flex: 0 0 auto;\r\n  }\r\n\r\n  .scb-ctaLeft p{\r\n    margin: 0;\r\n    line-height: 1.65;\r\n    color: rgba(255,255,255,0.82);\r\n  }\r\n\r\n  .scb-ctaBtns{\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    gap: 10px;\r\n  }\r\n\r\n  .scb-btn{\r\n    display: inline-flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    padding: 12px 18px;\r\n    border-radius: 999px;\r\n    font-weight: 900;\r\n    text-decoration: none;\r\n    line-height: 1;\r\n    white-space: nowrap;\r\n    border: 1px solid rgba(255,255,255,0.18);\r\n    transition: transform .12s ease, box-shadow .12s ease;\r\n  }\r\n\r\n  .scb-btnPrimary{\r\n    background: #dcae60;\r\n    color: #0b0b0b;\r\n    border-color: rgba(220,174,96,0.65);\r\n    box-shadow: 0 10px 24px rgba(220,174,96,0.25);\r\n  }\r\n\r\n  .scb-btnOutline{\r\n    background: transparent;\r\n    color: #ffffff;\r\n    border-color: rgba(220,174,96,0.55);\r\n  }\r\n\r\n  \/* Subtle hover (cheap, no performance hit) *\/\r\n  .scb-btn:hover{ transform: translateY(-1px); }\r\n\r\n  \/* Desktop layout *\/\r\n  @media (min-width: 920px){\r\n    .scb-grid{\r\n      grid-template-columns: repeat(3, 1fr);\r\n      gap: 16px;\r\n    }\r\n    .scb-card{ padding: 20px; }\r\n    .scb-cta{\r\n      grid-template-columns: 1.3fr 0.7fr;\r\n      align-items: center;\r\n      padding: 20px;\r\n    }\r\n    .scb-ctaBtns{ justify-content: flex-end; }\r\n  }\r\n\r\n  \/* Small screens *\/\r\n  @media (max-width: 420px){\r\n    .scb-card{ padding: 16px; }\r\n    .scb-icon{ width: 44px; height: 44px; border-radius: 14px; }\r\n  }\r\n<\/style>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-4e1434a e-con-full e-flex e-con e-parent\" data-id=\"4e1434a\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-68ad08c elementor-widget elementor-widget-html\" data-id=\"68ad08c\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<!-- \u2705 SHOPCARDBOARDBOXES.COM \u2014 USE CASES BY BOX STRENGTH & SIZE (Icons + Catchy + CWV-safe)\r\nPaste into Elementor > HTML widget\r\n\r\nColor scheme: #dcae60 + black + white\r\nButtons:\r\n- Shop Now: https:\/\/shopcardboardboxes.com\/products\/\r\n- Get Quote: https:\/\/shopcardboardboxes.com\/contact-us\/\r\nNo heavy images, no libraries, no JS (Core Web Vitals friendly)\r\n-->\r\n\r\n<section class=\"scb-usecases\" aria-label=\"Use cases by box strength and size\">\r\n  <div class=\"scb-wrap\">\r\n\r\n    <header class=\"scb-head\">\r\n      <span class=\"scb-pill\">\r\n        <span class=\"scb-pillIcon\" aria-hidden=\"true\">\r\n          <!-- target icon -->\r\n          <svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\">\r\n            <path d=\"M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z\" stroke=\"currentColor\" stroke-width=\"1.7\"\/>\r\n            <path d=\"M12 16a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z\" stroke=\"currentColor\" stroke-width=\"1.7\"\/>\r\n            <path d=\"M12 12h.01\" stroke=\"currentColor\" stroke-width=\"3.2\" stroke-linecap=\"round\"\/>\r\n          <\/svg>\r\n        <\/span>\r\n        Choose boxes that match real-world handling\r\n      <\/span>\r\n\r\n      <h2>Use Cases by Box Strength and Size<\/h2>\r\n      <p>\r\n        Not every shipment needs the same box strength. Use this quick guide to match box type, size,\r\n        and durability to your product weight and transit conditions.\r\n      <\/p>\r\n    <\/header>\r\n\r\n    <div class=\"scb-grid\" role=\"list\">\r\n\r\n      <!-- Card 1 -->\r\n      <article class=\"scb-card\" role=\"listitem\">\r\n        <div class=\"scb-top\">\r\n          <div class=\"scb-icon\" aria-hidden=\"true\">\r\n            <!-- feather icon -->\r\n            <svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\">\r\n              <path d=\"M20 4c-6 0-11 5-11 11v5h5c6 0 11-5 11-11 0-2-2-4-5-5Z\"\r\n                stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"\/>\r\n              <path d=\"M9 15c3-3 7-6 11-6\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"\/>\r\n            <\/svg>\r\n          <\/div>\r\n          <div class=\"scb-meta\">\r\n            <span class=\"scb-tag\">Lightweight<\/span>\r\n            <h3>Small Boxes for Mailing and Samples<\/h3>\r\n          <\/div>\r\n        <\/div>\r\n        <ul class=\"scb-list\">\r\n          <li><span class=\"scb-check\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M5 12l4 4 10-10\" stroke=\"currentColor\" stroke-width=\"2.2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/><\/svg><\/span>Small items, accessories, documents<\/li>\r\n          <li><span class=\"scb-check\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M5 12l4 4 10-10\" stroke=\"currentColor\" stroke-width=\"2.2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/><\/svg><\/span>Low shipping weight, short transit<\/li>\r\n          <li><span class=\"scb-check\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M5 12l4 4 10-10\" stroke=\"currentColor\" stroke-width=\"2.2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/><\/svg><\/span>Works well with fillers and inserts<\/li>\r\n        <\/ul>\r\n      <\/article>\r\n\r\n      <!-- Card 2 -->\r\n      <article class=\"scb-card scb-cardAccent\" role=\"listitem\">\r\n        <div class=\"scb-top\">\r\n          <div class=\"scb-icon\" aria-hidden=\"true\">\r\n            <!-- box + arrow icon -->\r\n            <svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\">\r\n              <path d=\"M3.5 7.5 12 3l8.5 4.5L12 12 3.5 7.5Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"\/>\r\n              <path d=\"M3.5 7.5V17L12 21l8.5-4V7.5\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"\/>\r\n              <path d=\"M13 9h7\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"\/>\r\n              <path d=\"M18 6l3 3-3 3\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/>\r\n            <\/svg>\r\n          <\/div>\r\n          <div class=\"scb-meta\">\r\n            <span class=\"scb-tag\">Everyday Shipping<\/span>\r\n            <h3>Medium Boxes for E-commerce Orders<\/h3>\r\n          <\/div>\r\n        <\/div>\r\n        <ul class=\"scb-list\">\r\n          <li><span class=\"scb-check\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M5 12l4 4 10-10\" stroke=\"currentColor\" stroke-width=\"2.2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/><\/svg><\/span>Apparel, cosmetics, home items<\/li>\r\n          <li><span class=\"scb-check\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M5 12l4 4 10-10\" stroke=\"currentColor\" stroke-width=\"2.2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/><\/svg><\/span>Balanced strength and cost<\/li>\r\n          <li><span class=\"scb-check\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M5 12l4 4 10-10\" stroke=\"currentColor\" stroke-width=\"2.2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/><\/svg><\/span>Great for inserts and partitions<\/li>\r\n        <\/ul>\r\n      <\/article>\r\n\r\n      <!-- Card 3 -->\r\n      <article class=\"scb-card\" role=\"listitem\">\r\n        <div class=\"scb-top\">\r\n          <div class=\"scb-icon\" aria-hidden=\"true\">\r\n            <!-- shield icon -->\r\n            <svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\">\r\n              <path d=\"M12 3 20 7v6c0 5-3.4 8.1-8 9-4.6-.9-8-4-8-9V7l8-4Z\"\r\n                stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"\/>\r\n              <path d=\"M9 12.5 11 14.5l4-4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/>\r\n            <\/svg>\r\n          <\/div>\r\n          <div class=\"scb-meta\">\r\n            <span class=\"scb-tag\">Reinforced<\/span>\r\n            <h3>Heavy Duty Boxes for Fragile and Weighty Items<\/h3>\r\n          <\/div>\r\n        <\/div>\r\n        <ul class=\"scb-list\">\r\n          <li><span class=\"scb-check\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M5 12l4 4 10-10\" stroke=\"currentColor\" stroke-width=\"2.2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/><\/svg><\/span>Electronics, glass, tools, bulk items<\/li>\r\n          <li><span class=\"scb-check\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M5 12l4 4 10-10\" stroke=\"currentColor\" stroke-width=\"2.2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/><\/svg><\/span>Better crush resistance for transit<\/li>\r\n          <li><span class=\"scb-check\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M5 12l4 4 10-10\" stroke=\"currentColor\" stroke-width=\"2.2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/><\/svg><\/span>Recommended for long-distance shipping<\/li>\r\n        <\/ul>\r\n      <\/article>\r\n\r\n      <!-- Card 4 -->\r\n      <article class=\"scb-card\" role=\"listitem\">\r\n        <div class=\"scb-top\">\r\n          <div class=\"scb-icon\" aria-hidden=\"true\">\r\n            <!-- stack \/ storage icon -->\r\n            <svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\">\r\n              <path d=\"M4 7l8-4 8 4-8 4-8-4Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"\/>\r\n              <path d=\"M4 12l8 4 8-4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"\/>\r\n              <path d=\"M4 17l8 4 8-4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"\/>\r\n            <\/svg>\r\n          <\/div>\r\n          <div class=\"scb-meta\">\r\n            <span class=\"scb-tag\">Storage and Moving<\/span>\r\n            <h3>Large Boxes for Relocation and Warehousing<\/h3>\r\n          <\/div>\r\n        <\/div>\r\n        <ul class=\"scb-list\">\r\n          <li><span class=\"scb-check\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M5 12l4 4 10-10\" stroke=\"currentColor\" stroke-width=\"2.2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/><\/svg><\/span>Clothing, bedding, mixed household goods<\/li>\r\n          <li><span class=\"scb-check\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M5 12l4 4 10-10\" stroke=\"currentColor\" stroke-width=\"2.2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/><\/svg><\/span>Stackable shape with stable edges<\/li>\r\n          <li><span class=\"scb-check\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M5 12l4 4 10-10\" stroke=\"currentColor\" stroke-width=\"2.2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/><\/svg><\/span>Ideal for storage rooms and warehouses<\/li>\r\n        <\/ul>\r\n      <\/article>\r\n\r\n    <\/div>\r\n\r\n    <!-- Bottom CTA -->\r\n    <div class=\"scb-cta\">\r\n      <div class=\"scb-ctaLeft\">\r\n        <h3>\r\n          <span class=\"scb-ctaIcon\" aria-hidden=\"true\">\r\n            <!-- lightning icon -->\r\n            <svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\">\r\n              <path d=\"M13 2 4 14h7l-1 8 10-14h-7l0-6Z\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linejoin=\"round\"\/>\r\n            <\/svg>\r\n          <\/span>\r\n          Want the right box without guesswork?\r\n        <\/h3>\r\n        <p>Shop standard sizes now, or request a quote for custom dimensions and printing.<\/p>\r\n      <\/div>\r\n\r\n      <div class=\"scb-ctaBtns\">\r\n        <a class=\"scb-btn scb-btnPrimary\" href=\"https:\/\/shopcardboardboxes.com\/products\/\">Shop Now<\/a>\r\n        <a class=\"scb-btn scb-btnOutline\" href=\"https:\/\/shopcardboardboxes.com\/contact-us\/\">Get Quote<\/a>\r\n      <\/div>\r\n    <\/div>\r\n\r\n  <\/div>\r\n<\/section>\r\n\r\n<style>\r\n  \/* =========\r\n     Theme\r\n     Gold: #dcae60\r\n     Black: #0b0b0b\r\n     White: #ffffff\r\n     ========= *\/\r\n\r\n  .scb-usecases{\r\n    padding: clamp(30px, 4vw, 72px) 0;\r\n    background:\r\n      radial-gradient(900px 420px at 12% 10%, rgba(220,174,96,0.16), transparent 55%),\r\n      radial-gradient(700px 360px at 92% 20%, rgba(220,174,96,0.10), transparent 55%),\r\n      linear-gradient(180deg, rgba(0,0,0,0.02), transparent 70%);\r\n  }\r\n\r\n  .scb-wrap{\r\n    width: min(1120px, calc(100% - 32px));\r\n    margin: 0 auto;\r\n  }\r\n\r\n  .scb-head{\r\n    max-width: 860px;\r\n    margin: 0 auto 18px;\r\n    text-align: left;\r\n  }\r\n\r\n  .scb-pill{\r\n    display: inline-flex;\r\n    align-items: center;\r\n    gap: 8px;\r\n    padding: 7px 12px;\r\n    border-radius: 999px;\r\n    background: rgba(220,174,96,0.14);\r\n    border: 1px solid rgba(220,174,96,0.35);\r\n    color: #0b0b0b;\r\n    font-size: 13px;\r\n    line-height: 1;\r\n    margin-bottom: 12px;\r\n  }\r\n\r\n  .scb-pillIcon{\r\n    width: 26px;\r\n    height: 26px;\r\n    border-radius: 999px;\r\n    display: grid;\r\n    place-items: center;\r\n    background: rgba(255,255,255,0.92);\r\n    border: 1px solid rgba(220,174,96,0.35);\r\n    color: #0b0b0b;\r\n  }\r\n\r\n  .scb-head h2{\r\n    margin: 0 0 10px;\r\n    font-size: clamp(22px, 2.8vw, 38px);\r\n    line-height: 1.12;\r\n    letter-spacing: -0.02em;\r\n    color: #0b0b0b;\r\n  }\r\n\r\n  .scb-head p{\r\n    margin: 0;\r\n    font-size: 16px;\r\n    line-height: 1.65;\r\n    color: rgba(11,11,11,0.82);\r\n  }\r\n\r\n  .scb-grid{\r\n    display: grid;\r\n    grid-template-columns: 1fr;\r\n    gap: 14px;\r\n    margin-top: 18px;\r\n  }\r\n\r\n  .scb-card{\r\n    background: #ffffff;\r\n    border: 1px solid rgba(11,11,11,0.10);\r\n    border-radius: 18px;\r\n    padding: 18px;\r\n    box-shadow: 0 12px 32px rgba(0,0,0,0.06);\r\n    position: relative;\r\n    overflow: hidden;\r\n  }\r\n\r\n  .scb-cardAccent{\r\n    border-color: rgba(220,174,96,0.50);\r\n    box-shadow: 0 14px 40px rgba(220,174,96,0.16);\r\n  }\r\n  .scb-cardAccent::before{\r\n    content:\"\";\r\n    position:absolute;\r\n    inset:-2px;\r\n    background: radial-gradient(680px 240px at 12% 10%, rgba(220,174,96,0.18), transparent 58%);\r\n    pointer-events:none;\r\n  }\r\n\r\n  .scb-top{\r\n    display: flex;\r\n    gap: 12px;\r\n    align-items: flex-start;\r\n    margin-bottom: 10px;\r\n    position: relative;\r\n    z-index: 1;\r\n  }\r\n\r\n  .scb-icon{\r\n    width: 48px;\r\n    height: 48px;\r\n    border-radius: 16px;\r\n    display: grid;\r\n    place-items: center;\r\n    background: rgba(220,174,96,0.12);\r\n    border: 1px solid rgba(220,174,96,0.35);\r\n    color: #0b0b0b;\r\n    flex: 0 0 auto;\r\n  }\r\n\r\n  .scb-meta{ min-width: 0; }\r\n  .scb-tag{\r\n    display: inline-flex;\r\n    align-items: center;\r\n    padding: 4px 10px;\r\n    border-radius: 999px;\r\n    font-size: 12px;\r\n    font-weight: 800;\r\n    background: rgba(11,11,11,0.05);\r\n    border: 1px solid rgba(11,11,11,0.10);\r\n    color: rgba(11,11,11,0.72);\r\n    margin-bottom: 6px;\r\n  }\r\n\r\n  .scb-card h3{\r\n    margin: 0;\r\n    font-size: 18px;\r\n    line-height: 1.25;\r\n    color: #0b0b0b;\r\n  }\r\n\r\n  .scb-list{\r\n    list-style: none;\r\n    padding: 0;\r\n    margin: 12px 0 0;\r\n    position: relative;\r\n    z-index: 1;\r\n  }\r\n  .scb-list li{\r\n    display: grid;\r\n    grid-template-columns: 18px 1fr;\r\n    gap: 10px;\r\n    align-items: start;\r\n    margin: 9px 0;\r\n    line-height: 1.6;\r\n    color: rgba(11,11,11,0.84);\r\n  }\r\n  .scb-check{\r\n    width: 18px;\r\n    height: 18px;\r\n    display: grid;\r\n    place-items: center;\r\n    color: #dcae60;\r\n    margin-top: 2px;\r\n  }\r\n  .scb-check svg{ width: 18px; height: 18px; }\r\n\r\n  .scb-cta{\r\n    margin-top: 16px;\r\n    border-radius: 20px;\r\n    padding: 18px;\r\n    background: #0b0b0b;\r\n    color: #ffffff;\r\n    border: 1px solid rgba(220,174,96,0.35);\r\n    display: grid;\r\n    gap: 12px;\r\n    box-shadow: 0 18px 44px rgba(0,0,0,0.18);\r\n  }\r\n\r\n  .scb-ctaLeft h3{\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 10px;\r\n    margin: 0 0 6px;\r\n    font-size: 18px;\r\n    line-height: 1.25;\r\n  }\r\n\r\n  .scb-ctaIcon{\r\n    width: 34px;\r\n    height: 34px;\r\n    border-radius: 999px;\r\n    display: grid;\r\n    place-items: center;\r\n    background: rgba(220,174,96,0.14);\r\n    border: 1px solid rgba(220,174,96,0.35);\r\n    color: #dcae60;\r\n    flex: 0 0 auto;\r\n  }\r\n\r\n  .scb-ctaLeft p{\r\n    margin: 0;\r\n    line-height: 1.65;\r\n    color: rgba(255,255,255,0.82);\r\n  }\r\n\r\n  .scb-ctaBtns{\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    gap: 10px;\r\n  }\r\n\r\n  .scb-btn{\r\n    display: inline-flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    padding: 12px 18px;\r\n    border-radius: 999px;\r\n    font-weight: 900;\r\n    text-decoration: none;\r\n    line-height: 1;\r\n    white-space: nowrap;\r\n    border: 1px solid rgba(255,255,255,0.18);\r\n    transition: transform .12s ease, box-shadow .12s ease;\r\n  }\r\n\r\n  .scb-btnPrimary{\r\n    background: #dcae60;\r\n    color: #0b0b0b;\r\n    border-color: rgba(220,174,96,0.65);\r\n    box-shadow: 0 10px 24px rgba(220,174,96,0.25);\r\n  }\r\n\r\n  .scb-btnOutline{\r\n    background: transparent;\r\n    color: #ffffff;\r\n    border-color: rgba(220,174,96,0.55);\r\n  }\r\n\r\n  .scb-btn:hover{ transform: translateY(-1px); }\r\n\r\n  @media (min-width: 920px){\r\n    .scb-grid{\r\n      grid-template-columns: repeat(2, 1fr);\r\n      gap: 16px;\r\n    }\r\n    .scb-card{ padding: 20px; }\r\n    .scb-cta{\r\n      grid-template-columns: 1.3fr 0.7fr;\r\n      align-items: center;\r\n      padding: 20px;\r\n    }\r\n    .scb-ctaBtns{ justify-content: flex-end; }\r\n  }\r\n\r\n  @media (max-width: 420px){\r\n    .scb-card{ padding: 16px; }\r\n    .scb-icon{ width: 44px; height: 44px; border-radius: 14px; }\r\n  }\r\n<\/style>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-11dbc37 e-con-full e-flex e-con e-parent\" data-id=\"11dbc37\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-77c0c06 elementor-widget elementor-widget-html\" data-id=\"77c0c06\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<!-- \u2705 SHOPCARDBOARDBOXES.COM \u2014 SUSTAINABILITY & ECO PACKAGING (Icons + Catchy + CWV-safe)\r\nPaste into Elementor > HTML widget\r\n\r\nColor scheme: #dcae60 + black + white\r\nButtons:\r\n- Shop Now: https:\/\/shopcardboardboxes.com\/products\/\r\n- Get Quote: https:\/\/shopcardboardboxes.com\/contact-us\/\r\nNo heavy images, no external libraries, no JS\r\n-->\r\n\r\n<section class=\"scb-eco\" aria-label=\"Sustainability and eco friendly packaging\">\r\n  <div class=\"scb-ecoWrap\">\r\n\r\n    <header class=\"scb-ecoHead\">\r\n      <span class=\"scb-ecoPill\">\r\n        <span class=\"scb-ecoPillIcon\" aria-hidden=\"true\">\r\n          <!-- leaf icon -->\r\n          <svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\">\r\n            <path d=\"M20 4c-9 1-14 7-14 14 7 0 13-5 14-14Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"\/>\r\n            <path d=\"M6 18c3-4 7-7 14-10\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"\/>\r\n          <\/svg>\r\n        <\/span>\r\n        Packaging choices that make sense\r\n      <\/span>\r\n\r\n      <h2>Sustainability and Eco Friendly Packaging<\/h2>\r\n      <p>\r\n        Cardboard packaging is a practical option when you want protection, presentation, and better material choices.\r\n        We focus on packaging that supports recyclability and efficient shipping while staying simple for everyday orders.\r\n      <\/p>\r\n    <\/header>\r\n\r\n    <div class=\"scb-ecoGrid\" role=\"list\">\r\n\r\n      <!-- Card 1 -->\r\n      <article class=\"scb-ecoCard\" role=\"listitem\">\r\n        <div class=\"scb-ecoTop\">\r\n          <div class=\"scb-ecoIcon\" aria-hidden=\"true\">\r\n            <!-- recycle icon -->\r\n            <svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\">\r\n              <path d=\"M7 7 9 3h6l2 4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/>\r\n              <path d=\"M5 12H3l3-5\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/>\r\n              <path d=\"M17 17l-2 4H9l-2-4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/>\r\n              <path d=\"M21 12h-2l-3 5\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/>\r\n            <\/svg>\r\n          <\/div>\r\n          <div class=\"scb-ecoMeta\">\r\n            <span class=\"scb-ecoTag\">Recyclable Materials<\/span>\r\n            <h3>Built for Recycling and Reuse<\/h3>\r\n          <\/div>\r\n        <\/div>\r\n\r\n        <p class=\"scb-ecoText\">\r\n          Cardboard is widely accepted for recycling. Using right-sized boxes can also help reduce filler and waste.\r\n        <\/p>\r\n\r\n        <ul class=\"scb-ecoList\">\r\n          <li>\r\n            <span class=\"scb-ecoCheck\" aria-hidden=\"true\">\r\n              <svg viewBox=\"0 0 24 24\"><path d=\"M5 12l4 4 10-10\" stroke=\"currentColor\" stroke-width=\"2.2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/><\/svg>\r\n            <\/span>\r\n            Recyclable cardboard and corrugated options\r\n          <\/li>\r\n          <li>\r\n            <span class=\"scb-ecoCheck\" aria-hidden=\"true\">\r\n              <svg viewBox=\"0 0 24 24\"><path d=\"M5 12l4 4 10-10\" stroke=\"currentColor\" stroke-width=\"2.2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/><\/svg>\r\n            <\/span>\r\n            Easy to break down for storage and disposal\r\n          <\/li>\r\n        <\/ul>\r\n      <\/article>\r\n\r\n      <!-- Card 2 -->\r\n      <article class=\"scb-ecoCard scb-ecoCardAccent\" role=\"listitem\">\r\n        <div class=\"scb-ecoTop\">\r\n          <div class=\"scb-ecoIcon\" aria-hidden=\"true\">\r\n            <!-- box-fit icon -->\r\n            <svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\">\r\n              <path d=\"M4 7h16v10H4V7Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"\/>\r\n              <path d=\"M8 11h8\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"\/>\r\n              <path d=\"M12 9v6\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"\/>\r\n            <\/svg>\r\n          <\/div>\r\n          <div class=\"scb-ecoMeta\">\r\n            <span class=\"scb-ecoTag\">Right Size Packaging<\/span>\r\n            <h3>Less Waste with Better Fit<\/h3>\r\n          <\/div>\r\n        <\/div>\r\n\r\n        <p class=\"scb-ecoText\">\r\n          Choosing the right box size helps reduce empty space, extra filler, and shipping volume.\r\n          It\u2019s a simple step that often improves handling too.\r\n        <\/p>\r\n\r\n        <ul class=\"scb-ecoList\">\r\n          <li>\r\n            <span class=\"scb-ecoCheck\" aria-hidden=\"true\">\r\n              <svg viewBox=\"0 0 24 24\"><path d=\"M5 12l4 4 10-10\" stroke=\"currentColor\" stroke-width=\"2.2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/><\/svg>\r\n            <\/span>\r\n            More efficient packing and stacking\r\n          <\/li>\r\n          <li>\r\n            <span class=\"scb-ecoCheck\" aria-hidden=\"true\">\r\n              <svg viewBox=\"0 0 24 24\"><path d=\"M5 12l4 4 10-10\" stroke=\"currentColor\" stroke-width=\"2.2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/><\/svg>\r\n            <\/span>\r\n            Reduced shipping volume where possible\r\n          <\/li>\r\n        <\/ul>\r\n      <\/article>\r\n\r\n      <!-- Card 3 -->\r\n      <article class=\"scb-ecoCard\" role=\"listitem\">\r\n        <div class=\"scb-ecoTop\">\r\n          <div class=\"scb-ecoIcon\" aria-hidden=\"true\">\r\n            <!-- shield-check icon -->\r\n            <svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\">\r\n              <path d=\"M12 3 20 7v6c0 5-3.4 8.1-8 9-4.6-.9-8-4-8-9V7l8-4Z\"\r\n                stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"\/>\r\n              <path d=\"M9 12.5 11 14.5l4-4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/>\r\n            <\/svg>\r\n          <\/div>\r\n          <div class=\"scb-ecoMeta\">\r\n            <span class=\"scb-ecoTag\">Protection First<\/span>\r\n            <h3>Durable Packaging Reduces Replacements<\/h3>\r\n          <\/div>\r\n        <\/div>\r\n\r\n        <p class=\"scb-ecoText\">\r\n          Strong boxes help reduce damage during transit. Fewer replacements can mean fewer shipments and less waste over time.\r\n        <\/p>\r\n\r\n        <ul class=\"scb-ecoList\">\r\n          <li>\r\n            <span class=\"scb-ecoCheck\" aria-hidden=\"true\">\r\n              <svg viewBox=\"0 0 24 24\"><path d=\"M5 12l4 4 10-10\" stroke=\"currentColor\" stroke-width=\"2.2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/><\/svg>\r\n            <\/span>\r\n            Better protection for shipping and storage\r\n          <\/li>\r\n          <li>\r\n            <span class=\"scb-ecoCheck\" aria-hidden=\"true\">\r\n              <svg viewBox=\"0 0 24 24\"><path d=\"M5 12l4 4 10-10\" stroke=\"currentColor\" stroke-width=\"2.2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/><\/svg>\r\n            <\/span>\r\n            Helps reduce product damage risk\r\n          <\/li>\r\n        <\/ul>\r\n      <\/article>\r\n\r\n    <\/div>\r\n\r\n  \r\n\r\n  <\/div>\r\n<\/section>\r\n\r\n<style>\r\n  \/* =========\r\n     Theme\r\n     Gold: #dcae60\r\n     Black: #0b0b0b\r\n     White: #ffffff\r\n     ========= *\/\r\n\r\n  .scb-eco{\r\n    padding: clamp(30px, 4vw, 72px) 0;\r\n    background:\r\n      radial-gradient(900px 420px at 12% 10%, rgba(220,174,96,0.16), transparent 55%),\r\n      radial-gradient(700px 360px at 92% 20%, rgba(220,174,96,0.10), transparent 55%),\r\n      linear-gradient(180deg, rgba(0,0,0,0.02), transparent 70%);\r\n  }\r\n\r\n  .scb-ecoWrap{\r\n    width: min(1120px, calc(100% - 32px));\r\n    margin: 0 auto;\r\n  }\r\n\r\n  .scb-ecoHead{\r\n    max-width: 880px;\r\n    margin: 0 auto 18px;\r\n    text-align: left;\r\n  }\r\n\r\n  .scb-ecoPill{\r\n    display: inline-flex;\r\n    align-items: center;\r\n    gap: 8px;\r\n    padding: 7px 12px;\r\n    border-radius: 999px;\r\n    background: rgba(220,174,96,0.14);\r\n    border: 1px solid rgba(220,174,96,0.35);\r\n    color: #0b0b0b;\r\n    font-size: 13px;\r\n    line-height: 1;\r\n    margin-bottom: 12px;\r\n  }\r\n\r\n  .scb-ecoPillIcon{\r\n    width: 26px;\r\n    height: 26px;\r\n    border-radius: 999px;\r\n    display: grid;\r\n    place-items: center;\r\n    background: rgba(255,255,255,0.92);\r\n    border: 1px solid rgba(220,174,96,0.35);\r\n    color: #0b0b0b;\r\n  }\r\n\r\n  .scb-ecoHead h2{\r\n    margin: 0 0 10px;\r\n    font-size: clamp(22px, 2.8vw, 38px);\r\n    line-height: 1.12;\r\n    letter-spacing: -0.02em;\r\n    color: #0b0b0b;\r\n  }\r\n\r\n  .scb-ecoHead p{\r\n    margin: 0;\r\n    font-size: 16px;\r\n    line-height: 1.65;\r\n    color: rgba(11,11,11,0.82);\r\n  }\r\n\r\n  .scb-ecoGrid{\r\n    display: grid;\r\n    grid-template-columns: 1fr;\r\n    gap: 14px;\r\n    margin-top: 18px;\r\n  }\r\n\r\n  .scb-ecoCard{\r\n    background: #ffffff;\r\n    border: 1px solid rgba(11,11,11,0.10);\r\n    border-radius: 18px;\r\n    padding: 18px;\r\n    box-shadow: 0 12px 32px rgba(0,0,0,0.06);\r\n    position: relative;\r\n    overflow: hidden;\r\n  }\r\n\r\n  .scb-ecoCardAccent{\r\n    border-color: rgba(220,174,96,0.50);\r\n    box-shadow: 0 14px 40px rgba(220,174,96,0.16);\r\n  }\r\n  .scb-ecoCardAccent::before{\r\n    content:\"\";\r\n    position:absolute;\r\n    inset:-2px;\r\n    background: radial-gradient(680px 240px at 12% 10%, rgba(220,174,96,0.18), transparent 58%);\r\n    pointer-events:none;\r\n  }\r\n\r\n  .scb-ecoTop{\r\n    display: flex;\r\n    gap: 12px;\r\n    align-items: flex-start;\r\n    margin-bottom: 10px;\r\n    position: relative;\r\n    z-index: 1;\r\n  }\r\n\r\n  .scb-ecoIcon{\r\n    width: 48px;\r\n    height: 48px;\r\n    border-radius: 16px;\r\n    display: grid;\r\n    place-items: center;\r\n    background: rgba(220,174,96,0.12);\r\n    border: 1px solid rgba(220,174,96,0.35);\r\n    color: #0b0b0b;\r\n    flex: 0 0 auto;\r\n  }\r\n\r\n  .scb-ecoMeta{ min-width: 0; }\r\n  .scb-ecoTag{\r\n    display: inline-flex;\r\n    align-items: center;\r\n    padding: 4px 10px;\r\n    border-radius: 999px;\r\n    font-size: 12px;\r\n    font-weight: 800;\r\n    background: rgba(11,11,11,0.05);\r\n    border: 1px solid rgba(11,11,11,0.10);\r\n    color: rgba(11,11,11,0.72);\r\n    margin-bottom: 6px;\r\n  }\r\n\r\n  .scb-ecoCard h3{\r\n    margin: 0;\r\n    font-size: 18px;\r\n    line-height: 1.25;\r\n    color: #0b0b0b;\r\n  }\r\n\r\n  .scb-ecoText{\r\n    margin: 8px 0 0;\r\n    line-height: 1.65;\r\n    color: rgba(11,11,11,0.84);\r\n    position: relative;\r\n    z-index: 1;\r\n  }\r\n\r\n  .scb-ecoList{\r\n    list-style: none;\r\n    padding: 0;\r\n    margin: 12px 0 0;\r\n    position: relative;\r\n    z-index: 1;\r\n  }\r\n  .scb-ecoList li{\r\n    display: grid;\r\n    grid-template-columns: 18px 1fr;\r\n    gap: 10px;\r\n    align-items: start;\r\n    margin: 9px 0;\r\n    line-height: 1.6;\r\n    color: rgba(11,11,11,0.84);\r\n  }\r\n\r\n  .scb-ecoCheck{\r\n    width: 18px;\r\n    height: 18px;\r\n    display: grid;\r\n    place-items: center;\r\n    color: #dcae60;\r\n    margin-top: 2px;\r\n  }\r\n  .scb-ecoCheck svg{ width: 18px; height: 18px; }\r\n\r\n  .scb-ecoCta{\r\n    margin-top: 16px;\r\n    border-radius: 20px;\r\n    padding: 18px;\r\n    background: #0b0b0b;\r\n    color: #ffffff;\r\n    border: 1px solid rgba(220,174,96,0.35);\r\n    display: grid;\r\n    gap: 12px;\r\n    box-shadow: 0 18px 44px rgba(0,0,0,0.18);\r\n  }\r\n\r\n  .scb-ecoCtaLeft h3{\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 10px;\r\n    margin: 0 0 6px;\r\n    font-size: 18px;\r\n    line-height: 1.25;\r\n  }\r\n\r\n  .scb-ecoCtaIcon{\r\n    width: 34px;\r\n    height: 34px;\r\n    border-radius: 999px;\r\n    display: grid;\r\n    place-items: center;\r\n    background: rgba(220,174,96,0.14);\r\n    border: 1px solid rgba(220,174,96,0.35);\r\n    color: #dcae60;\r\n    flex: 0 0 auto;\r\n  }\r\n\r\n  .scb-ecoCtaLeft p{\r\n    margin: 0;\r\n    line-height: 1.65;\r\n    color: rgba(255,255,255,0.82);\r\n  }\r\n\r\n  .scb-ecoBtns{\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    gap: 10px;\r\n  }\r\n\r\n  .scb-ecoBtn{\r\n    display: inline-flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    padding: 12px 18px;\r\n    border-radius: 999px;\r\n    font-weight: 900;\r\n    text-decoration: none;\r\n    line-height: 1;\r\n    white-space: nowrap;\r\n    border: 1px solid rgba(255,255,255,0.18);\r\n    transition: transform .12s ease, box-shadow .12s ease;\r\n  }\r\n\r\n  .scb-ecoBtnPrimary{\r\n    background: #dcae60;\r\n    color: #0b0b0b;\r\n    border-color: rgba(220,174,96,0.65);\r\n    box-shadow: 0 10px 24px rgba(220,174,96,0.25);\r\n  }\r\n\r\n  .scb-ecoBtnOutline{\r\n    background: transparent;\r\n    color: #ffffff;\r\n    border-color: rgba(220,174,96,0.55);\r\n  }\r\n\r\n  .scb-ecoBtn:hover{ transform: translateY(-1px); }\r\n\r\n  @media (min-width: 920px){\r\n    .scb-ecoGrid{\r\n      grid-template-columns: repeat(3, 1fr);\r\n      gap: 16px;\r\n    }\r\n    .scb-ecoCard{ padding: 20px; }\r\n    .scb-ecoCta{\r\n      grid-template-columns: 1.3fr 0.7fr;\r\n      align-items: center;\r\n      padding: 20px;\r\n    }\r\n    .scb-ecoBtns{ justify-content: flex-end; }\r\n  }\r\n\r\n  @media (max-width: 420px){\r\n    .scb-ecoCard{ padding: 16px; }\r\n    .scb-ecoIcon{ width: 44px; height: 44px; border-radius: 14px; }\r\n  }\r\n<\/style>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-bca3daf e-flex e-con-boxed e-con e-parent\" data-id=\"bca3daf\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-b9ac802 elementor-widget elementor-widget-html\" data-id=\"b9ac802\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<!-- \u2705 SHOPCARDBOARDBOXES.COM \u2014 HOMEPAGE FAQ (SEO + AEO, Icons + CWV-safe)\r\nPaste into Elementor > HTML widget\r\n\r\nColor scheme: #dcae60 + black + white\r\nButtons:\r\n- Shop Now: https:\/\/shopcardboardboxes.com\/products\/\r\n- Get Quote: https:\/\/shopcardboardboxes.com\/contact-us\/\r\n\r\nNotes:\r\n- No JS, no external libraries (Core Web Vitals safe)\r\n- Uses <details>\/<summary> for accessible accordion\r\n- Includes FAQPage JSON-LD schema for SEO\r\n-->\r\n\r\n<section class=\"scb-faq\" aria-label=\"Frequently asked questions\">\r\n  <div class=\"scb-faqWrap\">\r\n\r\n    <header class=\"scb-faqHead\">\r\n      <span class=\"scb-faqPill\">\r\n        <span class=\"scb-faqPillIcon\" aria-hidden=\"true\">\r\n          <!-- question icon -->\r\n          <svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\">\r\n            <path d=\"M12 18h.01\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\"\/>\r\n            <path d=\"M9.5 9.2a2.6 2.6 0 1 1 4.1 2.2c-.9.6-1.6 1.1-1.6 2.6\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"\/>\r\n            <path d=\"M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z\" stroke=\"currentColor\" stroke-width=\"1.8\"\/>\r\n          <\/svg>\r\n        <\/span>\r\n        Quick answers before you order\r\n      <\/span>\r\n\r\n      <h2>Frequently Asked Questions<\/h2>\r\n      <p>\r\n        Find sizing, strength, and ordering details in one place. If you still need help, you can shop standard boxes\r\n        or request a quote for custom requirements.\r\n      <\/p>\r\n    <\/header>\r\n\r\n    <div class=\"scb-faqGrid\">\r\n      <div class=\"scb-faqCol\">\r\n\r\n        <details class=\"scb-item\">\r\n          <summary>\r\n            <span class=\"scb-qIcon\" aria-hidden=\"true\">\r\n              <svg viewBox=\"0 0 24 24\"><path d=\"M5 12h14\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"\/><path d=\"M12 5v14\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"\/><\/svg>\r\n            <\/span>\r\n            What cardboard box sizes are available?\r\n          <\/summary>\r\n          <div class=\"scb-ans\">\r\n            We offer a range of standard sizes suitable for shipping, storage, and moving. If you need a specific size,\r\n            request a quote and share your dimensions and quantity.\r\n          <\/div>\r\n        <\/details>\r\n\r\n        <details class=\"scb-item\">\r\n          <summary>\r\n            <span class=\"scb-qIcon\" aria-hidden=\"true\">\r\n              <svg viewBox=\"0 0 24 24\"><path d=\"M5 12h14\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"\/><path d=\"M12 5v14\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"\/><\/svg>\r\n            <\/span>\r\n            What is the difference between cardboard and corrugated boxes?\r\n          <\/summary>\r\n          <div class=\"scb-ans\">\r\n            Corrugated boxes typically include a fluted layer between linerboards, improving strength for shipping and stacking.\r\n            Cardboard may be used as a general term, but corrugated is the common choice for transit protection.\r\n          <\/div>\r\n        <\/details>\r\n\r\n        <details class=\"scb-item\">\r\n          <summary>\r\n            <span class=\"scb-qIcon\" aria-hidden=\"true\">\r\n              <svg viewBox=\"0 0 24 24\"><path d=\"M5 12h14\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"\/><path d=\"M12 5v14\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"\/><\/svg>\r\n            <\/span>\r\n            Can I order boxes in bulk?\r\n          <\/summary>\r\n          <div class=\"scb-ans\">\r\n            Yes. Bulk orders are available for businesses and frequent shippers. For larger quantities, request a quote so we can\r\n            match the best option for your box type and requirements.\r\n          <\/div>\r\n        <\/details>\r\n\r\n        <details class=\"scb-item\">\r\n          <summary>\r\n            <span class=\"scb-qIcon\" aria-hidden=\"true\">\r\n              <svg viewBox=\"0 0 24 24\"><path d=\"M5 12h14\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"\/><path d=\"M12 5v14\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"\/><\/svg>\r\n            <\/span>\r\n            Do you offer custom box sizes?\r\n          <\/summary>\r\n          <div class=\"scb-ans\">\r\n            Yes. If standard sizes do not fit your products, we can help with custom sizing. Share the internal dimensions and\r\n            intended use case when requesting a quote.\r\n          <\/div>\r\n        <\/details>\r\n\r\n        <details class=\"scb-item\">\r\n          <summary>\r\n            <span class=\"scb-qIcon\" aria-hidden=\"true\">\r\n              <svg viewBox=\"0 0 24 24\"><path d=\"M5 12h14\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"\/><path d=\"M12 5v14\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"\/><\/svg>\r\n            <\/span>\r\n            Which box strength should I choose for shipping?\r\n          <\/summary>\r\n          <div class=\"scb-ans\">\r\n            It depends on product weight, fragility, and transit distance. For heavier or fragile items, stronger corrugated options\r\n            help reduce crush risk. If unsure, request a quote and share what you\u2019re packing.\r\n          <\/div>\r\n        <\/details>\r\n\r\n      <\/div>\r\n\r\n      <div class=\"scb-faqCol\">\r\n\r\n        <details class=\"scb-item\">\r\n          <summary>\r\n            <span class=\"scb-qIcon\" aria-hidden=\"true\">\r\n              <svg viewBox=\"0 0 24 24\"><path d=\"M5 12h14\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"\/><path d=\"M12 5v14\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"\/><\/svg>\r\n            <\/span>\r\n            Do you provide custom printing on boxes?\r\n          <\/summary>\r\n          <div class=\"scb-ans\">\r\n            Custom printing is available for branded packaging. Request a quote and include your logo\/artwork details, print areas,\r\n            and quantity so we can guide you on the best print approach.\r\n          <\/div>\r\n        <\/details>\r\n\r\n        <details class=\"scb-item\">\r\n          <summary>\r\n            <span class=\"scb-qIcon\" aria-hidden=\"true\">\r\n              <svg viewBox=\"0 0 24 24\"><path d=\"M5 12h14\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"\/><path d=\"M12 5v14\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"\/><\/svg>\r\n            <\/span>\r\n            Are your cardboard boxes recyclable?\r\n          <\/summary>\r\n          <div class=\"scb-ans\">\r\n            Most cardboard and corrugated boxes are recyclable. Keeping boxes clean and dry improves recycling acceptance. If you need\r\n            guidance for a specific use case, we can help.\r\n          <\/div>\r\n        <\/details>\r\n\r\n        <details class=\"scb-item\">\r\n          <summary>\r\n            <span class=\"scb-qIcon\" aria-hidden=\"true\">\r\n              <svg viewBox=\"0 0 24 24\"><path d=\"M5 12h14\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"\/><path d=\"M12 5v14\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"\/><\/svg>\r\n            <\/span>\r\n            How do I measure a box correctly?\r\n          <\/summary>\r\n          <div class=\"scb-ans\">\r\n            Use internal dimensions and measure in the order: length \u00d7 width \u00d7 height. Include space for inserts or padding when shipping\r\n            fragile products.\r\n          <\/div>\r\n        <\/details>\r\n\r\n        <details class=\"scb-item\">\r\n          <summary>\r\n            <span class=\"scb-qIcon\" aria-hidden=\"true\">\r\n              <svg viewBox=\"0 0 24 24\"><path d=\"M5 12h14\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"\/><path d=\"M12 5v14\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"\/><\/svg>\r\n            <\/span>\r\n            Can I use these boxes for moving and storage?\r\n          <\/summary>\r\n          <div class=\"scb-ans\">\r\n            Yes. Many customers use corrugated boxes for moving and storage. For stacking or heavier items, stronger box options can help\r\n            reduce bending and collapse over time.\r\n          <\/div>\r\n        <\/details>\r\n\r\n        <details class=\"scb-item\">\r\n          <summary>\r\n            <span class=\"scb-qIcon\" aria-hidden=\"true\">\r\n              <svg viewBox=\"0 0 24 24\"><path d=\"M5 12h14\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"\/><path d=\"M12 5v14\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"\/><\/svg>\r\n            <\/span>\r\n            How do I get help choosing the right boxes?\r\n          <\/summary>\r\n          <div class=\"scb-ans\">\r\n            If you know your product size and weight, start with standard boxes in the shop. For custom requirements or bulk orders, request\r\n            a quote and share your details.\r\n          <\/div>\r\n        <\/details>\r\n\r\n      <\/div>\r\n    <\/div>\r\n\r\n  \r\n\r\n  <\/div>\r\n<\/section>\r\n\r\n<!-- \u2705 FAQ Schema (JSON-LD) -->\r\n<script type=\"application\/ld+json\">\r\n{\r\n  \"@context\": \"https:\/\/schema.org\",\r\n  \"@type\": \"FAQPage\",\r\n  \"mainEntity\": [\r\n    {\r\n      \"@type\": \"Question\",\r\n      \"name\": \"What cardboard box sizes are available?\",\r\n      \"acceptedAnswer\": {\r\n        \"@type\": \"Answer\",\r\n        \"text\": \"We offer a range of standard sizes suitable for shipping, storage, and moving. If you need a specific size, request a quote and share your dimensions and quantity.\"\r\n      }\r\n    },\r\n    {\r\n      \"@type\": \"Question\",\r\n      \"name\": \"What is the difference between cardboard and corrugated boxes?\",\r\n      \"acceptedAnswer\": {\r\n        \"@type\": \"Answer\",\r\n        \"text\": \"Corrugated boxes typically include a fluted layer between linerboards, improving strength for shipping and stacking. Corrugated is commonly used for transit protection.\"\r\n      }\r\n    },\r\n    {\r\n      \"@type\": \"Question\",\r\n      \"name\": \"Can I order boxes in bulk?\",\r\n      \"acceptedAnswer\": {\r\n        \"@type\": \"Answer\",\r\n        \"text\": \"Yes. Bulk orders are available. For larger quantities, request a quote so we can match the best option for your box type and requirements.\"\r\n      }\r\n    },\r\n    {\r\n      \"@type\": \"Question\",\r\n      \"name\": \"Do you offer custom box sizes?\",\r\n      \"acceptedAnswer\": {\r\n        \"@type\": \"Answer\",\r\n        \"text\": \"Yes. We can help with custom sizing. Share internal dimensions and the intended use case when requesting a quote.\"\r\n      }\r\n    },\r\n    {\r\n      \"@type\": \"Question\",\r\n      \"name\": \"Which box strength should I choose for shipping?\",\r\n      \"acceptedAnswer\": {\r\n        \"@type\": \"Answer\",\r\n        \"text\": \"Box strength depends on product weight, fragility, and transit distance. Stronger corrugated options help reduce crush risk for heavier or fragile items.\"\r\n      }\r\n    },\r\n    {\r\n      \"@type\": \"Question\",\r\n      \"name\": \"Do you provide custom printing on boxes?\",\r\n      \"acceptedAnswer\": {\r\n        \"@type\": \"Answer\",\r\n        \"text\": \"Yes. Custom printing is available for branded packaging. Request a quote and include artwork details, print areas, and quantity.\"\r\n      }\r\n    },\r\n    {\r\n      \"@type\": \"Question\",\r\n      \"name\": \"Are your cardboard boxes recyclable?\",\r\n      \"acceptedAnswer\": {\r\n        \"@type\": \"Answer\",\r\n        \"text\": \"Most cardboard and corrugated boxes are recyclable. Keeping boxes clean and dry improves recycling acceptance.\"\r\n      }\r\n    },\r\n    {\r\n      \"@type\": \"Question\",\r\n      \"name\": \"How do I measure a box correctly?\",\r\n      \"acceptedAnswer\": {\r\n        \"@type\": \"Answer\",\r\n        \"text\": \"Measure internal dimensions in the order length \u00d7 width \u00d7 height. Include space for inserts or padding when shipping fragile products.\"\r\n      }\r\n    },\r\n    {\r\n      \"@type\": \"Question\",\r\n      \"name\": \"Can I use these boxes for moving and storage?\",\r\n      \"acceptedAnswer\": {\r\n        \"@type\": \"Answer\",\r\n        \"text\": \"Yes. Corrugated boxes are commonly used for moving and storage. For stacking or heavier items, stronger options can help reduce bending and collapse.\"\r\n      }\r\n    },\r\n    {\r\n      \"@type\": \"Question\",\r\n      \"name\": \"How do I get help choosing the right boxes?\",\r\n      \"acceptedAnswer\": {\r\n        \"@type\": \"Answer\",\r\n        \"text\": \"Start with standard boxes in the shop if you know your size and weight. For custom requirements or bulk orders, request a quote and share your details.\"\r\n      }\r\n    }\r\n  ]\r\n}\r\n<\/script>\r\n\r\n<style>\r\n  \/* =========\r\n     Theme\r\n     Gold: #dcae60\r\n     Black: #0b0b0b\r\n     White: #ffffff\r\n     ========= *\/\r\n\r\n  .scb-faq{\r\n    padding: clamp(30px, 4vw, 72px) 0;\r\n    background:\r\n      radial-gradient(900px 420px at 12% 10%, rgba(220,174,96,0.16), transparent 55%),\r\n      radial-gradient(700px 360px at 92% 20%, rgba(220,174,96,0.10), transparent 55%),\r\n      linear-gradient(180deg, rgba(0,0,0,0.02), transparent 70%);\r\n  }\r\n\r\n  .scb-faqWrap{\r\n    width: min(1120px, calc(100% - 32px));\r\n    margin: 0 auto;\r\n  }\r\n\r\n  .scb-faqHead{\r\n    max-width: 880px;\r\n    margin: 0 auto 18px;\r\n    text-align: left;\r\n  }\r\n\r\n  .scb-faqPill{\r\n    display: inline-flex;\r\n    align-items: center;\r\n    gap: 8px;\r\n    padding: 7px 12px;\r\n    border-radius: 999px;\r\n    background: rgba(220,174,96,0.14);\r\n    border: 1px solid rgba(220,174,96,0.35);\r\n    color: #0b0b0b;\r\n    font-size: 13px;\r\n    line-height: 1;\r\n    margin-bottom: 12px;\r\n  }\r\n\r\n  .scb-faqPillIcon{\r\n    width: 26px;\r\n    height: 26px;\r\n    border-radius: 999px;\r\n    display: grid;\r\n    place-items: center;\r\n    background: rgba(255,255,255,0.92);\r\n    border: 1px solid rgba(220,174,96,0.35);\r\n    color: #0b0b0b;\r\n  }\r\n\r\n  .scb-faqHead h2{\r\n    margin: 0 0 10px;\r\n    font-size: clamp(22px, 2.8vw, 38px);\r\n    line-height: 1.12;\r\n    letter-spacing: -0.02em;\r\n    color: #0b0b0b;\r\n  }\r\n\r\n  .scb-faqHead p{\r\n    margin: 0;\r\n    font-size: 16px;\r\n    line-height: 1.65;\r\n    color: rgba(11,11,11,0.82);\r\n  }\r\n\r\n  .scb-faqGrid{\r\n    display: grid;\r\n    grid-template-columns: 1fr;\r\n    gap: 14px;\r\n    margin-top: 18px;\r\n  }\r\n\r\n  @media (min-width: 920px){\r\n    .scb-faqGrid{\r\n      grid-template-columns: 1fr 1fr;\r\n      gap: 16px;\r\n    }\r\n  }\r\n\r\n  .scb-item{\r\n    background: #fff;\r\n    border: 1px solid rgba(11,11,11,0.10);\r\n    border-radius: 16px;\r\n    padding: 0;\r\n    box-shadow: 0 12px 32px rgba(0,0,0,0.06);\r\n    overflow: hidden;\r\n    margin-bottom: 12px;\r\n  }\r\n\r\n  .scb-item summary{\r\n    list-style: none;\r\n    cursor: pointer;\r\n    display: grid;\r\n    grid-template-columns: 22px 1fr;\r\n    gap: 10px;\r\n    padding: 14px 14px;\r\n    align-items: start;\r\n    color: #0b0b0b;\r\n    font-weight: 900;\r\n    line-height: 1.35;\r\n  }\r\n  .scb-item summary::-webkit-details-marker{ display:none; }\r\n\r\n  .scb-qIcon{\r\n    width: 22px;\r\n    height: 22px;\r\n    border-radius: 10px;\r\n    display: grid;\r\n    place-items: center;\r\n    background: rgba(220,174,96,0.14);\r\n    border: 1px solid rgba(220,174,96,0.35);\r\n    color: #0b0b0b;\r\n    margin-top: 1px;\r\n  }\r\n  .scb-qIcon svg{ width: 16px; height: 16px; }\r\n\r\n  .scb-ans{\r\n    padding: 0 14px 14px;\r\n    color: rgba(11,11,11,0.84);\r\n    line-height: 1.65;\r\n  }\r\n\r\n  details[open]{\r\n    border-color: rgba(220,174,96,0.45);\r\n    box-shadow: 0 14px 40px rgba(220,174,96,0.14);\r\n  }\r\n\r\n  .scb-faqCta{\r\n    margin-top: 16px;\r\n    border-radius: 20px;\r\n    padding: 18px;\r\n    background: #0b0b0b;\r\n    color: #ffffff;\r\n    border: 1px solid rgba(220,174,96,0.35);\r\n    display: grid;\r\n    gap: 12px;\r\n    box-shadow: 0 18px 44px rgba(0,0,0,0.18);\r\n  }\r\n\r\n  .scb-faqCtaLeft h3{\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 10px;\r\n    margin: 0 0 6px;\r\n    font-size: 18px;\r\n    line-height: 1.25;\r\n  }\r\n\r\n  .scb-faqCtaIcon{\r\n    width: 34px;\r\n    height: 34px;\r\n    border-radius: 999px;\r\n    display: grid;\r\n    place-items: center;\r\n    background: rgba(220,174,96,0.14);\r\n    border: 1px solid rgba(220,174,96,0.35);\r\n    color: #dcae60;\r\n    flex: 0 0 auto;\r\n  }\r\n\r\n  .scb-faqCtaLeft p{\r\n    margin: 0;\r\n    line-height: 1.65;\r\n    color: rgba(255,255,255,0.82);\r\n  }\r\n\r\n  .scb-faqBtns{\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    gap: 10px;\r\n  }\r\n\r\n  .scb-faqBtn{\r\n    display: inline-flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    padding: 12px 18px;\r\n    border-radius: 999px;\r\n    font-weight: 900;\r\n    text-decoration: none;\r\n    line-height: 1;\r\n    white-space: nowrap;\r\n    border: 1px solid rgba(255,255,255,0.18);\r\n    transition: transform .12s ease, box-shadow .12s ease;\r\n  }\r\n\r\n  .scb-faqBtnPrimary{\r\n    background: #dcae60;\r\n    color: #0b0b0b;\r\n    border-color: rgba(220,174,96,0.65);\r\n    box-shadow: 0 10px 24px rgba(220,174,96,0.25);\r\n  }\r\n\r\n  .scb-faqBtnOutline{\r\n    background: transparent;\r\n    color: #ffffff;\r\n    border-color: rgba(220,174,96,0.55);\r\n  }\r\n\r\n  .scb-faqBtn:hover{ transform: translateY(-1px); }\r\n\r\n  @media (min-width: 920px){\r\n    .scb-faqCta{\r\n      grid-template-columns: 1.3fr 0.7fr;\r\n      align-items: center;\r\n      padding: 20px;\r\n    }\r\n    .scb-faqBtns{ justify-content: flex-end; }\r\n  }\r\n<\/style>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-bc55fcc e-flex e-con-boxed e-con e-parent\" data-id=\"bc55fcc\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-758ea49 elementor-widget elementor-widget-html\" data-id=\"758ea49\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<!-- \u2705 SHOPCARDBOARDBOXES.COM \u2014 TRUST SIGNALS (Lightweight, Icons + CWV-safe)\r\nPaste into Elementor > HTML widget\r\n\r\nColor scheme: #dcae60 + black + white\r\nButtons:\r\n- Shop Now: https:\/\/shopcardboardboxes.com\/products\/\r\n- Get Quote: https:\/\/shopcardboardboxes.com\/contact-us\/\r\n\r\nNotes:\r\n- No JS, no external libraries\r\n- Uses inline SVG icons (fast)\r\n- Metrics are written as placeholders\u2014replace with your real numbers\r\n-->\r\n\r\n<section class=\"scb-trust\" aria-label=\"Trust and reliability\">\r\n  <div class=\"scb-trustWrap\">\r\n\r\n    <header class=\"scb-trustHead\">\r\n      <span class=\"scb-trustPill\">\r\n        <span class=\"scb-trustPillIcon\" aria-hidden=\"true\">\r\n          <!-- shield icon -->\r\n          <svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\">\r\n            <path d=\"M12 3 20 7v6c0 5-3.4 8.1-8 9-4.6-.9-8-4-8-9V7l8-4Z\"\r\n              stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"\/>\r\n            <path d=\"M9 12.5 11 14.5l4-4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/>\r\n          <\/svg>\r\n        <\/span>\r\n        Trusted packaging for everyday shipping\r\n      <\/span>\r\n\r\n      <h2>Why Customers Choose Shop Cardboard Boxes<\/h2>\r\n      <p>\r\n        Simple ordering, dependable packaging, and support when you need it. These quick highlights help you buy with confidence.\r\n      <\/p>\r\n    <\/header>\r\n\r\n    <!-- Trust Cards -->\r\n    <div class=\"scb-trustGrid\" role=\"list\">\r\n\r\n      <article class=\"scb-trustCard\" role=\"listitem\">\r\n        <div class=\"scb-trustIcon\" aria-hidden=\"true\">\r\n          <!-- quality badge -->\r\n          <svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\">\r\n            <path d=\"M12 2l2.2 4.5 5 .7-3.6 3.5.9 5-4.5-2.4-4.5 2.4.9-5L4.8 7.2l5-.7L12 2Z\"\r\n              stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"\/>\r\n          <\/svg>\r\n        <\/div>\r\n        <h3>Consistent Quality<\/h3>\r\n        <p>Boxes designed for stacking, storage, and shipping protection across common use cases.<\/p>\r\n      <\/article>\r\n\r\n      <article class=\"scb-trustCard scb-trustCardAccent\" role=\"listitem\">\r\n        <div class=\"scb-trustIcon\" aria-hidden=\"true\">\r\n          <!-- boxes icon -->\r\n          <svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\">\r\n            <path d=\"M3.5 7.5 12 3l8.5 4.5L12 12 3.5 7.5Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"\/>\r\n            <path d=\"M3.5 7.5V17L12 21l8.5-4V7.5\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"\/>\r\n            <path d=\"M12 12v9\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"\/>\r\n          <\/svg>\r\n        <\/div>\r\n        <h3>Standard and Custom Options<\/h3>\r\n        <p>Shop standard sizes fast, or request a quote for custom dimensions and printing.<\/p>\r\n      <\/article>\r\n\r\n      <article class=\"scb-trustCard\" role=\"listitem\">\r\n        <div class=\"scb-trustIcon\" aria-hidden=\"true\">\r\n          <!-- support icon -->\r\n          <svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\">\r\n            <path d=\"M4 12a8 8 0 0 1 16 0v5a2 2 0 0 1-2 2h-2\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"\/>\r\n            <path d=\"M6 12v3a2 2 0 0 0 2 2h1\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"\/>\r\n            <path d=\"M9 19h6\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"\/>\r\n          <\/svg>\r\n        <\/div>\r\n        <h3>Helpful Support<\/h3>\r\n        <p>Get guidance on sizing, strength, and quantities so you choose the right packaging.<\/p>\r\n      <\/article>\r\n\r\n      <article class=\"scb-trustCard\" role=\"listitem\">\r\n        <div class=\"scb-trustIcon\" aria-hidden=\"true\">\r\n          <!-- clock icon -->\r\n          <svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\">\r\n            <path d=\"M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z\" stroke=\"currentColor\" stroke-width=\"1.8\"\/>\r\n            <path d=\"M12 7v5l3 2\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/>\r\n          <\/svg>\r\n        <\/div>\r\n        <h3>Fast Ordering Flow<\/h3>\r\n        <p>A clean shopping experience that keeps pages light and easy to use on mobile.<\/p>\r\n      <\/article>\r\n\r\n    <\/div>\r\n\r\n    <!-- Optional mini stats (placeholders) -->\r\n    <div class=\"scb-trustStats\" role=\"list\" aria-label=\"Trust highlights\">\r\n      <div class=\"scb-stat\" role=\"listitem\">\r\n        <span class=\"scb-statIcon\" aria-hidden=\"true\">\r\n          <!-- check -->\r\n          <svg viewBox=\"0 0 24 24\"><path d=\"M5 12l4 4 10-10\" stroke=\"currentColor\" stroke-width=\"2.2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/><\/svg>\r\n        <\/span>\r\n        <div>\r\n          <div class=\"scb-statValue\">10k+<\/div>\r\n          <div class=\"scb-statLabel\">Boxes shipped (replace)<\/div>\r\n        <\/div>\r\n      <\/div>\r\n\r\n      <div class=\"scb-stat\" role=\"listitem\">\r\n        <span class=\"scb-statIcon\" aria-hidden=\"true\">\r\n          <!-- users -->\r\n          <svg viewBox=\"0 0 24 24\" fill=\"none\">\r\n            <path d=\"M16 11a4 4 0 1 0-8 0 4 4 0 0 0 8 0Z\" stroke=\"currentColor\" stroke-width=\"1.8\"\/>\r\n            <path d=\"M4 21c1.8-3.5 5-5 8-5s6.2 1.5 8 5\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"\/>\r\n          <\/svg>\r\n        <\/span>\r\n        <div>\r\n          <div class=\"scb-statValue\">500+<\/div>\r\n          <div class=\"scb-statLabel\">Repeat customers (replace)<\/div>\r\n        <\/div>\r\n      <\/div>\r\n\r\n      <div class=\"scb-stat\" role=\"listitem\">\r\n        <span class=\"scb-statIcon\" aria-hidden=\"true\">\r\n          <!-- star -->\r\n          <svg viewBox=\"0 0 24 24\" fill=\"none\">\r\n            <path d=\"M12 2l2.2 4.5 5 .7-3.6 3.5.9 5-4.5-2.4-4.5 2.4.9-5L4.8 7.2l5-.7L12 2Z\"\r\n              stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"\/>\r\n          <\/svg>\r\n        <\/span>\r\n        <div>\r\n          <div class=\"scb-statValue\">4.8\/5<\/div>\r\n          <div class=\"scb-statLabel\">Average rating (replace)<\/div>\r\n        <\/div>\r\n      <\/div>\r\n    <\/div>\r\n\r\n\r\n\r\n  <\/div>\r\n<\/section>\r\n\r\n<style>\r\n  \/* =========\r\n     Theme\r\n     Gold: #dcae60\r\n     Black: #0b0b0b\r\n     White: #ffffff\r\n     ========= *\/\r\n\r\n  .scb-trust{\r\n    padding: clamp(30px, 4vw, 72px) 0;\r\n    background:\r\n      radial-gradient(900px 420px at 12% 10%, rgba(220,174,96,0.14), transparent 55%),\r\n      radial-gradient(700px 360px at 92% 20%, rgba(220,174,96,0.10), transparent 55%),\r\n      linear-gradient(180deg, rgba(0,0,0,0.02), transparent 70%);\r\n  }\r\n\r\n  .scb-trustWrap{\r\n    width: min(1120px, calc(100% - 32px));\r\n    margin: 0 auto;\r\n  }\r\n\r\n  .scb-trustHead{\r\n    max-width: 880px;\r\n    margin: 0 auto 18px;\r\n    text-align: left;\r\n  }\r\n\r\n  .scb-trustPill{\r\n    display: inline-flex;\r\n    align-items: center;\r\n    gap: 8px;\r\n    padding: 7px 12px;\r\n    border-radius: 999px;\r\n    background: rgba(220,174,96,0.14);\r\n    border: 1px solid rgba(220,174,96,0.35);\r\n    color: #0b0b0b;\r\n    font-size: 13px;\r\n    line-height: 1;\r\n    margin-bottom: 12px;\r\n  }\r\n\r\n  .scb-trustPillIcon{\r\n    width: 26px;\r\n    height: 26px;\r\n    border-radius: 999px;\r\n    display: grid;\r\n    place-items: center;\r\n    background: rgba(255,255,255,0.92);\r\n    border: 1px solid rgba(220,174,96,0.35);\r\n    color: #0b0b0b;\r\n  }\r\n\r\n  .scb-trustHead h2{\r\n    margin: 0 0 10px;\r\n    font-size: clamp(22px, 2.8vw, 38px);\r\n    line-height: 1.12;\r\n    letter-spacing: -0.02em;\r\n    color: #0b0b0b;\r\n  }\r\n\r\n  .scb-trustHead p{\r\n    margin: 0;\r\n    font-size: 16px;\r\n    line-height: 1.65;\r\n    color: rgba(11,11,11,0.82);\r\n  }\r\n\r\n  .scb-trustGrid{\r\n    display: grid;\r\n    grid-template-columns: 1fr;\r\n    gap: 14px;\r\n    margin-top: 18px;\r\n  }\r\n\r\n  .scb-trustCard{\r\n    background: #ffffff;\r\n    border: 1px solid rgba(11,11,11,0.10);\r\n    border-radius: 18px;\r\n    padding: 18px;\r\n    box-shadow: 0 12px 32px rgba(0,0,0,0.06);\r\n    position: relative;\r\n    overflow: hidden;\r\n  }\r\n\r\n  .scb-trustCardAccent{\r\n    border-color: rgba(220,174,96,0.50);\r\n    box-shadow: 0 14px 40px rgba(220,174,96,0.16);\r\n  }\r\n  .scb-trustCardAccent::before{\r\n    content:\"\";\r\n    position:absolute;\r\n    inset:-2px;\r\n    background: radial-gradient(680px 240px at 12% 10%, rgba(220,174,96,0.18), transparent 58%);\r\n    pointer-events:none;\r\n  }\r\n\r\n  .scb-trustIcon{\r\n    width: 48px;\r\n    height: 48px;\r\n    border-radius: 16px;\r\n    display: grid;\r\n    place-items: center;\r\n    background: rgba(220,174,96,0.12);\r\n    border: 1px solid rgba(220,174,96,0.35);\r\n    color: #0b0b0b;\r\n    margin-bottom: 12px;\r\n    position: relative;\r\n    z-index: 1;\r\n  }\r\n\r\n  .scb-trustCard h3{\r\n    margin: 0 0 6px;\r\n    font-size: 18px;\r\n    line-height: 1.25;\r\n    color: #0b0b0b;\r\n    position: relative;\r\n    z-index: 1;\r\n  }\r\n  .scb-trustCard p{\r\n    margin: 0;\r\n    line-height: 1.65;\r\n    color: rgba(11,11,11,0.84);\r\n    position: relative;\r\n    z-index: 1;\r\n  }\r\n\r\n  \/* Mini Stats *\/\r\n  .scb-trustStats{\r\n    margin-top: 14px;\r\n    display: grid;\r\n    grid-template-columns: 1fr;\r\n    gap: 12px;\r\n  }\r\n  .scb-stat{\r\n    background: #fff;\r\n    border: 1px solid rgba(11,11,11,0.10);\r\n    border-radius: 18px;\r\n    padding: 14px;\r\n    display: grid;\r\n    grid-template-columns: 40px 1fr;\r\n    gap: 12px;\r\n    align-items: center;\r\n    box-shadow: 0 12px 32px rgba(0,0,0,0.05);\r\n  }\r\n  .scb-statIcon{\r\n    width: 40px;\r\n    height: 40px;\r\n    border-radius: 14px;\r\n    display: grid;\r\n    place-items: center;\r\n    background: rgba(220,174,96,0.12);\r\n    border: 1px solid rgba(220,174,96,0.35);\r\n    color: #0b0b0b;\r\n  }\r\n  .scb-statIcon svg{ width: 20px; height: 20px; }\r\n  .scb-statValue{\r\n    font-weight: 950;\r\n    font-size: 18px;\r\n    color: #0b0b0b;\r\n    line-height: 1.2;\r\n  }\r\n  .scb-statLabel{\r\n    color: rgba(11,11,11,0.70);\r\n    font-size: 13px;\r\n    line-height: 1.3;\r\n  }\r\n\r\n  \/* CTA *\/\r\n  .scb-trustCta{\r\n    margin-top: 16px;\r\n    border-radius: 20px;\r\n    padding: 18px;\r\n    background: #0b0b0b;\r\n    color: #ffffff;\r\n    border: 1px solid rgba(220,174,96,0.35);\r\n    display: grid;\r\n    gap: 12px;\r\n    box-shadow: 0 18px 44px rgba(0,0,0,0.18);\r\n  }\r\n\r\n  .scb-trustCtaLeft h3{\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 10px;\r\n    margin: 0 0 6px;\r\n    font-size: 18px;\r\n    line-height: 1.25;\r\n  }\r\n\r\n  .scb-trustCtaIcon{\r\n    width: 34px;\r\n    height: 34px;\r\n    border-radius: 999px;\r\n    display: grid;\r\n    place-items: center;\r\n    background: rgba(220,174,96,0.14);\r\n    border: 1px solid rgba(220,174,96,0.35);\r\n    color: #dcae60;\r\n    flex: 0 0 auto;\r\n  }\r\n\r\n  .scb-trustCtaLeft p{\r\n    margin: 0;\r\n    line-height: 1.65;\r\n    color: rgba(255,255,255,0.82);\r\n  }\r\n\r\n  .scb-trustBtns{\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    gap: 10px;\r\n  }\r\n\r\n  .scb-trustBtn{\r\n    display: inline-flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    padding: 12px 18px;\r\n    border-radius: 999px;\r\n    font-weight: 900;\r\n    text-decoration: none;\r\n    line-height: 1;\r\n    white-space: nowrap;\r\n    border: 1px solid rgba(255,255,255,0.18);\r\n    transition: transform .12s ease, box-shadow .12s ease;\r\n  }\r\n\r\n  .scb-trustBtnPrimary{\r\n    background: #dcae60;\r\n    color: #0b0b0b;\r\n    border-color: rgba(220,174,96,0.65);\r\n    box-shadow: 0 10px 24px rgba(220,174,96,0.25);\r\n  }\r\n\r\n  .scb-trustBtnOutline{\r\n    background: transparent;\r\n    color: #ffffff;\r\n    border-color: rgba(220,174,96,0.55);\r\n  }\r\n\r\n  .scb-trustBtn:hover{ transform: translateY(-1px); }\r\n\r\n  @media (min-width: 920px){\r\n    .scb-trustGrid{\r\n      grid-template-columns: repeat(4, 1fr);\r\n      gap: 16px;\r\n    }\r\n    .scb-trustCard{ padding: 20px; }\r\n\r\n    .scb-trustStats{\r\n      grid-template-columns: repeat(3, 1fr);\r\n      gap: 14px;\r\n    }\r\n\r\n    .scb-trustCta{\r\n      grid-template-columns: 1.3fr 0.7fr;\r\n      align-items: center;\r\n      padding: 20px;\r\n    }\r\n    .scb-trustBtns{ justify-content: flex-end; }\r\n  }\r\n\r\n  @media (max-width: 420px){\r\n    .scb-trustCard{ padding: 16px; }\r\n    .scb-trustIcon{ width: 44px; height: 44px; border-radius: 14px; }\r\n  }\r\n<\/style>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-400adbee e-con-full e-flex e-con e-parent\" data-id=\"400adbee\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t<div class=\"elementor-element elementor-element-70ec1b2c e-con-full e-flex e-con e-child\" data-id=\"70ec1b2c\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-646dccb0 elementor-widget-tablet__width-inherit elementor-widget elementor-widget-heading\" data-id=\"646dccb0\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Let\u2019s work together<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-36997d87 elementor-widget elementor-widget-heading\" data-id=\"36997d87\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">Get in touch today and receive a complimentary consultation.<\/h3>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-20ea6707 e-con-full e-flex e-con e-child\" data-id=\"20ea6707\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-1719c270 elementor-widget elementor-widget-heading\" data-id=\"1719c270\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Email<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-669f0515 elementor-tablet-align-center elementor-icon-list--layout-traditional elementor-list-item-link-full_width elementor-widget elementor-widget-icon-list\" data-id=\"669f0515\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"icon-list.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<ul class=\"elementor-icon-list-items\">\n\t\t\t\t\t\t\t<li class=\"elementor-icon-list-item\">\n\t\t\t\t\t\t\t\t\t\t\t<a href=\"mailto:info@shopcardboardboxes\">\n\n\t\t\t\t\t\t\t\t\t\t\t<span class=\"elementor-icon-list-text\">info@shopcardboardboxes<\/span>\n\t\t\t\t\t\t\t\t\t\t\t<\/a>\n\t\t\t\t\t\t\t\t\t<\/li>\n\t\t\t\t\t\t<\/ul>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-79bfdbf9 e-con-full e-flex e-con e-child\" data-id=\"79bfdbf9\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-19eaea70 elementor-widget elementor-widget-heading\" data-id=\"19eaea70\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h2 class=\"elementor-hea