				<div class="elementor-widget-container">
															<img decoding="async" width="750" height="750" src="https://shopcardboardboxes.com/wp-content/uploads/2025/12/Custom-Cardboard-Small-Equipment-Boxes-1024x1024.jpg" class="attachment-large size-large wp-image-4750" alt="Custom Cardboard Small Equipment Boxes" srcset="https://shopcardboardboxes.com/wp-content/uploads/2025/12/Custom-Cardboard-Small-Equipment-Boxes-1024x1024.jpg 1024w, https://shopcardboardboxes.com/wp-content/uploads/2025/12/Custom-Cardboard-Small-Equipment-Boxes-300x300.jpg 300w, https://shopcardboardboxes.com/wp-content/uploads/2025/12/Custom-Cardboard-Small-Equipment-Boxes-150x150.jpg 150w, https://shopcardboardboxes.com/wp-content/uploads/2025/12/Custom-Cardboard-Small-Equipment-Boxes-768x768.jpg 768w, https://shopcardboardboxes.com/wp-content/uploads/2025/12/Custom-Cardboard-Small-Equipment-Boxes-600x600.jpg 600w, https://shopcardboardboxes.com/wp-content/uploads/2025/12/Custom-Cardboard-Small-Equipment-Boxes-100x100.jpg 100w, https://shopcardboardboxes.com/wp-content/uploads/2025/12/Custom-Cardboard-Small-Equipment-Boxes.jpg 1080w" sizes="(max-width: 750px) 100vw, 750px" />															</div>
				</div>
