<th data-start="10071" data-end="10092" data-col-size="sm"><strong data-start="10073" data-end="10092">Design Reminder</strong></th>
</tr>
</thead>
<tbody data-start="10113" data-end="10871">
<tr data-start="10113" data-end="10268">
<td data-start="10113" data-end="10137" data-col-size="sm">Board color and texture</td>
<td data-start="10137" data-end="10176" data-col-size="sm">Natural kraft, white, tinted options</td>
<td data-start="10176" data-end="10211" data-col-size="sm">Aligns tone with mail visibility</td>
<td data-start="10211" data-end="10240" data-col-size="sm">Corporate and creative use</td>
<td data-start="10240" data-end="10268" data-col-size="sm">Keep label contrast strong</td>
</tr>
<tr data-start="10269" data-end="10427">
