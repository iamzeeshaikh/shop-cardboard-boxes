<td data-start="12992" data-end="13030" data-col-size="sm">Holds handouts and workbooks neatly</td>
<td data-start="13030" data-end="13063" data-col-size="sm">Use clean mailers for sessions</td>
<td data-start="13063" data-end="13089" data-col-size="sm">Multiple training rounds</td>
</tr>
<tr data-start="13090" data-end="13220">
<td data-start="13090" data-end="13115" data-col-size="sm">Reference sample holders</td>
<td data-start="13115" data-end="13140" data-col-size="sm">Print and design teams</td>
<td data-start="13140" data-end="13175" data-col-size="sm">Protects catalogs and proof sets</td>
<td data-start="13175" data-end="13200" data-col-size="sm">Store upright in racks</td>
<td data-start="13200" data-end="13220" data-col-size="sm">Many review cycles</td>
</tr>
<tr data-start="13221" data-end="13363">
<td data-start="13221" data-end="13245" data-col-size="sm">Project archive bundles</td>
