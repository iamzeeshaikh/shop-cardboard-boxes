] dark:decoration-textOffDark\/30 dark:hover:decoration-super\/80 transition-all motion-reduce:transition-none appearance-none bg-transparent border-0 p-0 m-0 [td_&amp;]:table-cell align-baseline inline-block align-top\" type=\"button\" data-state=\"closed\">Thickness<\/button><\/strong><\/td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\">&#8211; 16pt (approx. 0.4 mm)<br \/>\n&#8211; 20pt (approx. 0.5 mm)<br \/>\n&#8211; 24pt (approx. 0.6 mm)<\/td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\">&#8211; Kraft Board<br \/>\n&#8211; Whiteboard<br \/>\n&#8211; Recycled Board<\/td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\">&#8211; Water-resistant Coating<br \/>\n&#8211; Food-safe Coating<\/td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\">&#8211; Pre-glued for Easy Assembly<br \/>\n&#8211; Fold-flat Design for Efficient Storage<\/td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\">&#8211; Heavy-duty Packaging for Large Burgers<br \/>\n&#8211; Sturdy Boxes for Delivery and Transport<\/td>\n<\/tr>\n<tr>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\"><strong><button class=\"hover:duration-80 duration-800 cursor-pointer text-left align-baseline inline underline decoration-textOff\/25 decoration-1 underline-offset-[5px] animate-underlineFade after:content-[&quot;&quot;] hover:text-super hover:decoration-super\/80 hover:underline-offset-[7px] dark:decoration-textOffDark\/30 dark:hover:decoration-super\/80 transition-all motion-reduce:transition-none appearance-none bg-transparent border-0 p-0 m-0 [td_&amp;]:table-cell align-baseline inline-block align-top\" type=\"button\" data-state=\"closed\">Printing Options<\/button><\/strong><\/td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\">&#8211; Full-color CMYK<br \/>\n&#8211; Spot Colors<br \/>\n&#8211; Digital Printing<br \/>\n&#8211; Offset Printing<\/td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\">&#8211; Compatible with all listed materials<\/td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\">&#8211; UV Coating for Vibrant Colors<br \/>\n&#8211; Matte or Gloss Lamination<\/td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\">&#8211; Custom Branding<br \/>\n&#8211; QR Codes<br \/>\n&#8211; Nutritional Information Printing<\/td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\">&#8211; Promotional Packaging<br \/>\n&#8211; Seasonal or Limited Edition Boxes<\/td>\n<\/tr>\n<tr>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\"><strong><button class=\"hover:duration-80 duration-800 cursor-pointer text-left align-baseline inline underline decoration-textOff\/25 decoration-1 underline-offset-[5px] animate-underlineFade after:content-[&quot;&quot;] hover:text-super hover:decoration-super\/80 hover:underline-offset-[7px] dark:decoration-textOffDark\/30 dark:hover:decoration-super\/80 transition-all motion-reduce:transition-none appearance-none bg-transparent border-0 p-0 m-0 [td_&amp;]:table-cell align-baseline inline-block align-top\" type=\"button\" data-state=\"closed\">Sustainability<\/button><\/strong><\/td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\">&#8211; 100% Recyclable Materials<br \/>\n&#8211; Biodegradable Inks<br \/>\n&#8211; Compostable Options Available<\/td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\">&#8211; Recycled Kraft<br \/>\n&#8211; FSC-certified Paperboard<\/td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\">&#8211; Eco-friendly Water-based Coatings<\/td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\">&#8211; Minimal Plastic Use<br \/>\n&#8211; Soy-based Printing Inks<\/td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\">&#8211; Environmentally Conscious Brands<br \/>\n&#8211; Green Packaging Initiatives<\/td>\n<\/tr>\n<tr>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\"><strong><button class=\"hover:duration-80 duration-800 cursor-pointer text-left align-baseline inline underline decoration-textOff\/25 decoration-1 underline-offset-[5px] animate-underlineFade after:content-[&quot;&quot;] hover:text-super hover:decoration-super\/80 hover:underline-offset-[7px] dark:decoration-textOffDark\/30 dark:hover:decoration-super\/80 transition-all motion-reduce:transition-none appearance-none bg-transparent border-0 p-0 m-0 [td_&amp;]:table-cell align-baseline inline-block align-top\" type=\"button\" data-state=\"closed\">Additional Features<\/button><\/strong><\/td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\">&#8211; Easy Assembly Design<br \/>\n&#8211; Stackable Boxes<br \/>\n&#8211; Microwave Safe (certain materials)<br \/>\n&#8211; Grease-resistant Liners<\/td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\">&#8211; Food-grade Laminated Boards<br \/>\n&#8211; Greaseproof Paperboard<\/td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\">&#8211; Anti-grease Coating<br \/>\n&#8211; Heat Sealable Surfaces<\/td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\">&#8211; Inserts for Cutlery or Condiments<br \/>\n&#8211; Tamper-evident Seals<\/td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\">&#8211; Fast Food Chains<br \/>\n&#8211; Gourmet Burger Outlets<br \/>\n&#8211; Food Delivery Services<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<h3>Common Uses for Custom Burger Boxes<\/h3>\n<p>Our <strong>burger packaging boxes<\/strong> are perfect for:<\/p>\n<ol>\n<li>Fast food burgers (classic or double-stack)<\/li>\n<li>Sliders and chicken sandwiches<\/li>\n<li>Vegan or gourmet burger packaging<\/li>\n<li>Limited edition promotions<\/li>\n<li>Combo boxes with fries and dips<\/li>\n<\/ol>\n<p>You can also request <strong>large cardboard burger boxes<\/strong> for multi-item meal packaging or party packs.<\/p>\n<hr \/>\n<h2>Printing and Finish Options to Match Your Brand<\/h2>\n<h3>High-Quality CMYK and PMS Printing<\/h3>\n<p>Our cardboard burger boxes for sale are printed using advanced printing processes to ensure your logo, colors, and text are sharp and food-safe. We use soy-based or FDA-approved inks that won\u2019t affect taste or aroma.<\/p>\n<table class=\"border-borderMain dark:border-borderMainDark my-[1em] w-full table-auto border\">\n<thead class=\"bg-offset dark:bg-offsetDark\">\n<tr>\n<th class=\"border-borderMain px-sm py-sm dark:border-borderMainDark break-normal border text-left align-top\"><strong>Feature<\/strong><\/th>\n<th class=\"border-borderMain px-sm py-sm dark:border-borderMainDark break-normal border text-left align-top\"><strong>Details<\/strong><\/th>\n<th class=\"border-borderMain px-sm py-sm dark:border-borderMainDark break-normal border text-left align-top\"><strong>Material Options<\/strong><\/th>\n<th class=\"border-borderMain px-sm py-sm dark:border-borderMainDark break-normal border text-left align-top\"><strong>Finishing Choices<\/strong><\/th>\n<th class=\"border-borderMain px-sm py-sm dark:border-borderMainDark break-normal border text-left align-top\"><strong>Add-ons &amp; Features<\/strong><\/th>\n<th class=\"border-borderMain px-sm py-sm dark:border-borderMainDark break-normal border text-left align-top\"><strong>Usage\u00a0 Application<\/strong><\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\"><strong><button class=\"hover:duration-80 duration-800 cursor-pointer text-left align-baseline inline underline decoration-textOff\/25 decoration-1 underline-offset-[5px] animate-underlineFade after:content-[&quot;&quot;] hover:text-super hover:decoration-super\/80 hover:underline-offset-[7px] dark:decoration-textOffDark\/30 dark:hover:decoration-super\/80 transition-all motion-reduce:transition-none appearance-none bg-transparent border-0 p-0 m-0 [td_&amp;]:table-cell align-baseline inline-block align-top\" type=\"button\" data-state=\"closed\">Printing<\/button><\/strong><\/td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\">&#8211; Full-color printing using CMYK or Pantone Matching System (PMS)<\/td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\">&#8211; Kraft paper (natural brown texture)<\/td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\">&#8211; Offset printing for large runs<\/td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\">&#8211; QR codes for interactive marketing<\/td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\">&#8211; Custom burger boxes for dine-in or takeaway<\/td>\n<\/tr>\n<tr>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\"><\/td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\">&#8211; Option for no print to maintain natural look<\/td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48p