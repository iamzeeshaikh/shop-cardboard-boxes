on","@id":"https:\/\/shopcardboardboxes.com\/#organization","name":"Shop Cardboard Boxes","url":"https:\/\/shopcardboardboxes.com\/","logo":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/shopcardboardboxes.com\/#\/schema\/logo\/image\/","url":"","contentUrl":"","caption":"Shop Cardboard Boxes"},"image":{"@id":"https:\/\/shopcardboardboxes.com\/#\/schema\/logo\/image\/"}}]}},"_links":{"self":[{"href":"https:\/\/shopcardboardboxes.com\/wp-json\/wp\/v2\/product\/2985","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/shopcardboardboxes.com\/wp-json\/wp\/v2\/product"}],"about":[{"href":"https:\/\/shopcardboardboxes.com\/wp-json\/wp\/v2\/types\/product"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/shopcardboardboxes.com\/wp-json\/wp\/v2\/media\/3060"}],"wp:attachment":[{"href":"https:\/\/shopcardboardboxes.com\/wp-json\/wp\/v2\/media?parent=2985"}],"wp:term":[{"taxonomy":"product_brand","embeddable":true,"href":"https:\/\/shopcardboardboxes.com\/wp-json\/wp\/v2\/product_brand?post=2985"},{"taxonomy":"product_cat","embeddable":true,"href":"https:\/\/shopcardboardboxes.com\/wp-json\/wp\/v2\/product_cat?post=2985"},{"taxonomy":"product_tag","embeddable":true,"href":"https:\/\/shopcardboardboxes.com\/wp-json\/wp\/v2\/product_tag?post=2985"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}